{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run check",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/studio",
      "destination": "https://quinnsoftwarestudio.com/",
      "permanent": true
    },
    {
      "source": "/studio/privacy",
      "destination": "https://quinnsoftwarestudio.com/privacy",
      "permanent": true
    },
    {
      "source": "/studio/work/:slug",
      "destination": "https://quinnsoftwarestudio.com/work/:slug",
      "permanent": true
    },
    {
      "source": "/studio/sitemap.xml",
      "destination": "https://quinnsoftwarestudio.com/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/studio/robots.txt",
      "destination": "https://quinnsoftwarestudio.com/robots.txt",
      "permanent": true
    },
    {
      "source": "/studio/:asset*",
      "destination": "https://quinnsoftwarestudio.com/studio/:asset*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/studio-inquiry",
      "destination": "https://quinnsoftwarestudio.com/api/studio-inquiry"
    }
  ]
}
