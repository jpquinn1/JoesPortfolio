---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import StudioLayout from '../../../layouts/StudioLayout.astro';
import DemoPreview from '../../../components/studio/DemoPreview.astro';
import { brand, caseStudies } from '../../../data/studio';

export const getStaticPaths = (() =>
  caseStudies.map((study) => ({ params: { slug: study.slug }, props: { study } }))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { study } = Astro.props;
const nextStudy = caseStudies[(caseStudies.findIndex((item) => item.slug === study.slug) + 1) % caseStudies.length];
---

<StudioLayout title={`${study.shortTitle} | ${brand.name}`} description={study.summary}>
  <article class="case-study">
    <header class="case-hero studio-shell">
      <a class="back-link" href={`${brand.basePath}#work`}><span aria-hidden="true">←</span> All Studio work</a>
      <div class="case-meta"><span class="eyebrow">Field notes / {study.number}</span><span class="case-status">{study.status}</span></div>
      <h1>{study.title}</h1>
      <p class="case-summary">{study.summary}</p>
      <ul class="case-tags" aria-label="Areas of focus">{study.tags.map((tag) => <li>{tag}</li>)}</ul>
    </header>

    <section class="case-demo studio-shell" aria-labelledby="demo-title">
      <h2 id="demo-title" class="visually-hidden">{study.shortTitle} demonstration</h2>
      <DemoPreview variant={study.variant} />
      <p class="demo-caption">{study.demoDescription}</p>
    </section>

    <div class="case-body studio-shell">
      <aside class="case-context" aria-label="Project context">
        <p class="eyebrow">The context</p>
        <p>{study.category}</p>
        <div class="context-note"><h2>Experience, clearly labeled.</h2><p>{study.experienceNote}</p></div>
        <a class="text-link" href={`${brand.basePath}#contact`}>Discuss a similar problem <span aria-hidden="true">↗</span></a>
      </aside>

      <div class="case-sections">
        <section aria-labelledby="problem-title"><p class="eyebrow">01 / The problem</p><h2 id="problem-title">What needs to work better.</h2><p>{study.problem}</p></section>
        <section aria-labelledby="approach-title"><p class="eyebrow">02 / Engineering approach</p><h2 id="approach-title">Build a useful system around it.</h2><ol class="approach-list">{study.approach.map((step, index) => <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{step}</p></li>)}</ol></section>
        <section aria-labelledby="capability-title"><p class="eyebrow">03 / Demonstrated capability</p><h2 id="capability-title">What this work shows.</h2><p>{study.demonstratedCapability}</p></section>
        <section aria-labelledby="applications-title"><p class="eyebrow">04 / Business applications</p><h2 id="applications-title">Where the same thinking can help.</h2><ul class="applications-list">{study.applications.map((application) => <li>{application}</li>)}</ul><p class="applications-note">These are potential applications, not a list of past Studio client engagements.</p></section>
        <details class="technical-details"><summary>For the technically curious <span aria-hidden="true">+</span></summary><ul>{study.technicalNotes.map((note) => <li>{note}</li>)}</ul></details>
        <section class="portfolio-links" aria-labelledby="portfolio-title"><p class="eyebrow">Further reading</p><h2 id="portfolio-title">Explore the engineering background.</h2><p>The personal portfolio contains earlier project write-ups. The status notes on this page distinguish that experience from the Studio’s independent demonstrations.</p>{study.relatedPortfolio.map((link) => <a class="text-link" href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}</section>
      </div>
    </div>

    <section class="case-cta" aria-labelledby="case-cta-title"><div class="studio-shell case-cta-inner"><div><p class="eyebrow">Start with your operation</p><h2 id="case-cta-title">What would make your work easier?</h2><p>A messy workflow, a disconnected system, or an idea worth testing. That’s a useful place to start.</p></div><a class="studio-button studio-button--light" href={`${brand.basePath}#contact`}>Discuss a Project <span aria-hidden="true">↗</span></a></div></section>
    <nav class="case-next studio-shell" aria-label="More work"><a href={`${brand.basePath}#work`}>← Back to all work</a><a href={`${brand.basePath}/work/${nextStudy.slug}`}><span>Next field note</span>{nextStudy.shortTitle} →</a></nav>
  </article>
</StudioLayout>

<style>
  .case-hero { padding-top: 3.5rem; padding-bottom: 3.25rem; }
  .back-link { display: inline-flex; gap: .65rem; align-items: center; font-size: .88rem; text-decoration: none; color: #545b55; padding: .4rem 0; }
  .back-link:hover { color: #984725; }
  .case-meta { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; margin-top: 3.5rem; margin-bottom: 1.5rem; }
  .case-meta .eyebrow { margin: 0; }
  .case-status { padding: .45rem .7rem; border: 1px solid #c9c1b5; border-radius: 4px; font-size: .72rem; color: #545b55; }
  h1 { max-width: 1050px; font-size: clamp(2.7rem, 6.5vw, 5.8rem); letter-spacing: -.065em; line-height: 1.02; margin: 0; font-weight: 600; }
  .case-summary { max-width: 730px; font-size: clamp(1.1rem, 2vw, 1.35rem); color: #545b55; line-height: 1.7; margin: 1.8rem 0; }
  .case-tags { display: flex; flex-wrap: wrap; list-style: none; padding: 0; gap: .5rem 1.5rem; font-size: .78rem; color: #545b55; }
  .case-tags li::before { content: '↗'; color: #984725; margin-right: .45rem; }
  .case-demo { padding-bottom: 4rem; }
  .demo-caption { max-width: 880px; color: #545b55; font-size: .85rem; line-height: 1.7; margin: 1rem 0 0; }
  .case-body { display: grid; grid-template-columns: minmax(0, .7fr) minmax(0, 1.7fr); gap: clamp(2rem, 7vw, 7rem); padding-bottom: 6rem; }
  .case-context { border-top: 1px solid #c9c1b5; padding-top: 1.6rem; font-size: .87rem; line-height: 1.7; color: #545b55; }
  .context-note { padding: 1.1rem 0 1.6rem; }
  .context-note h2 { font-size: .9rem; color: #252a2c; letter-spacing: -.01em; margin-bottom: .7rem; }
  .text-link { color: #252a2c; text-underline-offset: .25rem; text-decoration-thickness: 1px; font-size: .9rem; line-height: 1.6; }
  .text-link:hover { color: #984725; }
  .case-sections { min-width: 0; }
  .case-sections > section { border-top: 1px solid #c9c1b5; padding-top: 1.6rem; margin-bottom: 3.2rem; }
  .case-sections h2 { font-size: clamp(1.6rem, 3vw, 2.3rem); letter-spacing: -.045em; line-height: 1.15; margin: .8rem 0 1.25rem; font-weight: 600; }
  .case-sections p, .technical-details li { color: #545b55; font-size: 1rem; line-height: 1.8; }
  .case-sections p.eyebrow { font-size: .7rem; }
  .approach-list { list-style: none; padding: 0; }
  .approach-list li { display: grid; grid-template-columns: 2rem 1fr; gap: .8rem; margin-bottom: 1.2rem; }
  .approach-list p { margin: 0; }
  .step-number { color: #984725; font-size: .72rem; padding-top: .35rem; font-family: var(--font-jetbrains-mono, monospace); }
  .applications-list { padding: 0; list-style: none; display: grid; grid-template-columns: 1fr 1fr; gap: .65rem 1.5rem; }
  .applications-list li { padding: 1rem 0; border-bottom: 1px solid #c9c1b5; line-height: 1.6; font-size: .95rem; }
  .case-sections .applications-note { font-size: .8rem; }
  .technical-details { border: 1px solid #c9c1b5; border-radius: 6px; margin-bottom: 3.2rem; padding: 1.2rem 1.4rem; }
  .technical-details summary { cursor: pointer; font-weight: 600; font-size: .95rem; line-height: 1.6; }
  .technical-details summary span { float: right; }
  .technical-details[open] summary span { transform: rotate(45deg); }
  .technical-details ul { padding-left: 1.1rem; margin: 1.2rem 0 0; }
  .technical-details li { font-size: .9rem; margin-bottom: .75rem; }
  .portfolio-links .text-link { display: block; padding: .5rem 0; }
  .case-cta { color: #f1e9dd; background: #252a2c; padding: 4.5rem 0; }
  .case-cta-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .case-cta h2 { font-size: clamp(2rem, 4vw, 3.4rem); max-width: 650px; letter-spacing: -.05em; line-height: 1.1; font-weight: 500; margin: 1rem 0; }
  .case-cta p { max-width: 590px; color: #d4d4c9; line-height: 1.7; }
  .case-cta .studio-button { flex-shrink: 0; }
  .case-next { display: flex; align-items: center; justify-content: space-between; gap: 2rem; padding-top: 2.5rem; padding-bottom: 2.5rem; }
  .case-next a { text-decoration: none; color: #252a2c; line-height: 1.7; font-size: .88rem; }
  .case-next a:last-child { text-align: right; }
  .case-next span { display: block; font-size: .68rem; text-transform: uppercase; letter-spacing: .1em; color: #545b55; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  @media (max-width: 740px) {
    .case-hero { padding-top: 2rem; }
    .case-meta { margin-top: 2.5rem; }
    .case-body { grid-template-columns: 1fr; gap: 2.5rem; padding-bottom: 3.5rem; }
    .case-context { order: 2; }
    .case-demo { padding-bottom: 2.5rem; }
    .case-cta-inner { flex-direction: column; align-items: flex-start; }
    .case-next { align-items: flex-start; }
  }
  @media (max-width: 420px) {
    .applications-list { grid-template-columns: 1fr; }
    .case-meta { gap: .8rem; }
    .case-next { flex-direction: column; }
    .case-next a:last-child { text-align: left; }
  }
</style>
