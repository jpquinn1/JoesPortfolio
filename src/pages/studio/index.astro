---
import StudioLayout from '../../layouts/StudioLayout.astro';
import OperationsDemo from '../../components/studio/OperationsDemo.astro';
import ServiceOutcomes from '../../components/studio/ServiceOutcomes.astro';
import ConnectedToolkit from '../../components/studio/ConnectedToolkit.astro';
import CapabilityMap from '../../components/studio/CapabilityMap.astro';
import WorkflowExplorer from '../../components/studio/WorkflowExplorer.astro';
import ProjectCarousel from '../../components/studio/ProjectCarousel.astro';
import ContactForm from '../../components/studio/ContactForm.astro';
import { founder, contact } from '../../data/studio';
import '../../styles/studio-refresh.css';

const steps = [
  { number: '01', title: 'Define', description: 'Review the current workflow, requirements, and scope.' },
  { number: '02', title: 'Prototype', description: 'Test an initial version with the people who will use it.' },
  { number: '03', title: 'Build & support', description: 'Implement, test, and deploy. Document the system and plan ongoing support.' },
];
---
<StudioLayout
  theme="technical"
  title="Quinn Software Studio — Software, automation & connected systems"
  description="Custom applications, workflow integrations, and telemetry systems by Joe Quinn. Independent software engineering in Phoenix, Arizona."
>
  <div class="studio-refresh" data-studio-motion="off">
    <section class="studio-hero" aria-labelledby="hero-title">
      <div class="studio-shell pitch-shell">
        <div class="hero-copy">
          <p class="eyebrow"><span class="availability-dot" aria-hidden="true"></span>Independent software engineering</p>
          <h1 id="hero-title">Software, automation<br /><span>& connected systems.</span></h1>
          <p class="hero-description">I design and build applications, integrations, and telemetry systems for businesses.</p>
          <div class="hero-actions"><a href="#work" class="studio-button">View projects <span aria-hidden="true">↗</span></a><a href="#contact" class="studio-text-link">Discuss a project <span aria-hidden="true">↓</span></a></div>
        </div>
        <div class="hero-demo" id="studio-demo"><OperationsDemo /></div>
        <div class="hero-footnote"><span>Forms / workflows / telemetry</span><span>Phoenix, AZ <span aria-hidden="true">·</span> Local & remote projects</span></div>
      </div>
    </section>

    <section id="services" class="studio-section outcomes-section" aria-labelledby="services-title">
      <div class="studio-shell pitch-shell">
        <div class="pitch-heading"><p class="eyebrow">01 / Services</p><h2 id="services-title">Project examples</h2><p>A few ways custom software can support everyday operations.</p></div>
        <ServiceOutcomes />
        <p class="illustration-note">Illustrative interfaces with sample data. Scope depends on the workflow.</p>
      </div>
    </section>

    <section id="capabilities" class="studio-section studio-dark toolkit-section" aria-labelledby="capabilities-title">
      <div class="studio-shell pitch-shell">
        <div class="pitch-heading"><p class="eyebrow">02 / Integrations</p><h2 id="capabilities-title">How the pieces connect</h2><p>Forms, existing tools, and equipment can share data through APIs and automated workflows.</p></div>
        <ConnectedToolkit />
        <div class="technical-details">
          <details class="more-detail"><summary>Engineering capabilities <span aria-hidden="true">+</span></summary><div class="detail-content"><CapabilityMap /></div></details>
          <details class="more-detail workflow-detail" id="explorer"><summary>Additional workflow examples <span aria-hidden="true">+</span></summary><div class="detail-content"><WorkflowExplorer /></div></details>
        </div>
      </div>
    </section>

    <section id="work" class="studio-section work-section" aria-labelledby="work-title">
      <div class="studio-shell pitch-shell work-heading"><div class="pitch-heading"><p class="eyebrow">03 / Selected work</p><h2 id="work-title">Engineering projects</h2><p>Applications, automation, and connected equipment I’ve built or contributed to.</p></div><a href="/projects" class="studio-text-link">All projects <span aria-hidden="true">↗</span></a></div>
      <ProjectCarousel />
      <p class="project-disclosure studio-shell">Professional in-house work and contributions, separate from Studio client projects. Each case study explains my role and the project’s status.</p>
    </section>

    <section id="about" class="studio-section partnership-section" aria-labelledby="about-title">
      <div class="studio-shell pitch-shell">
        <div class="founder-grid">
          <div class="founder-photo"><img src={founder.image} alt="Joe Quinn, founder of Quinn Software Studio" width="640" height="640" loading="lazy" decoding="async" /></div>
          <div class="pitch-heading"><p class="eyebrow">04 / About</p><h2 id="about-title">Joe Quinn</h2><p>My background spans application development, cloud services, and equipment in the field. I work directly with businesses on design, implementation, and support.</p><p class="founder-experience">TrackMan · PGA TOUR ShotLink<br />Computer Science & Engineering · Ohio State</p><a href="/about" class="studio-text-link">More about me <span aria-hidden="true">↗</span></a></div>
        </div>
        <ol class="approach-steps" aria-label="How we work together">{steps.map(step => <li><span>{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol>
      </div>
    </section>

    <section id="contact" class="studio-section studio-dark inquiry-section" aria-labelledby="contact-title">
      <div class="studio-shell pitch-shell inquiry-grid"><div class="pitch-heading inquiry-copy"><p class="eyebrow">05 / Contact</p><h2 id="contact-title">Discuss a project</h2><p>Describe the workflow, the systems involved, and what you’d like to change. An initial idea is enough to start.</p><a class="inquiry-email" href={contact.emailHref}>{contact.email} <span aria-hidden="true">↗</span></a><span class="inquiry-location">Phoenix, Arizona · Local & remote projects</span></div><ContactForm /></div>
    </section>
  </div>
</StudioLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-studio-motion]').forEach(root => {
    const button = root.querySelector<HTMLButtonElement>('[data-studio-motion-toggle]');
    if (!button) return;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = preference.matches;
    const sync = () => {
      root.dataset.studioMotion = paused || document.hidden ? 'off' : 'on';
      button.disabled = preference.matches;
      button.querySelector('[data-motion-label]')!.textContent = preference.matches ? 'Reduced motion' : paused ? 'Play motion' : 'Pause motion';
      button.querySelector('[aria-hidden]')!.textContent = paused ? '▷' : 'Ⅱ';
    };
    button.hidden = false;
    button.addEventListener('click', () => { paused = !paused; sync(); });
    preference.addEventListener('change', event => { paused = event.matches; sync(); });
    document.addEventListener('visibilitychange', sync);
    sync();
  });
</script>
