---
import StudioLayout from '../../layouts/StudioLayout.astro';
import DemoPreview from '../../components/studio/DemoPreview.astro';
import WorkflowExplorer from '../../components/studio/WorkflowExplorer.astro';
import CapabilityMap from '../../components/studio/CapabilityMap.astro';
import ContactForm from '../../components/studio/ContactForm.astro';
import { brand, founder, services, process, caseStudies, contact } from '../../data/studio';
---
<StudioLayout>
  <section class="hero studio-shell" aria-labelledby="hero-title">
    <div class="hero-topline"><p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Independent engineering · Phoenix & beyond</p><a href="/" class="portfolio-link">By Joe Quinn <span aria-hidden="true">↗</span></a></div>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title">{brand.headline.endsWith("run better.") ? <>{brand.headline.slice(0, -11)}<em>run better.</em></> : brand.headline}</h1>
        <p class="hero-description">{brand.description}</p>
        <div class="hero-actions"><a href="#contact" class="studio-button">Discuss a project <span aria-hidden="true">↗</span></a><a href="#work" class="studio-text-link">Explore our work <span aria-hidden="true">↓</span></a></div>
        <p class="hero-note">Built around your business.<br />By an engineer who understands operations.</p>
      </div>
      <div class="hero-media"><div class="preview-label"><span>THE WORK, MADE VISIBLE</span><span aria-hidden="true">01 / 04</span></div><DemoPreview variant="operations" caption="An independent concept for a clearer working day. Fictional data, practical possibilities." /><a href="#explorer" class="preview-cta">Where could better software help you? <span aria-hidden="true">↓</span></a></div>
    </div>
    <div class="hero-foot"><p>For businesses where<br /><strong>the work happens in the real world.</strong></p><ul aria-label="Businesses we can help"><li>Service & repair</li><li>Manufacturing</li><li>Warehousing</li><li>Equipment & maintenance</li></ul></div>
  </section>

  <section id="services" class="studio-section services-section" aria-labelledby="services-title">
    <div class="studio-shell">
      <div class="section-heading"><div><p class="eyebrow">01 / What we build</p><h2 id="services-title">Less working around software.<br />More software that works for you.</h2></div><p>When spreadsheets, disconnected tools, and manual follow-ups start holding things back, a focused piece of software can make the next step simpler.</p></div>
      <div class="services-grid">{services.map(service=><article class="service"><div class="service-top"><span>{service.number}</span><svg aria-hidden="true" viewBox="0 0 28 28" width="28" height="28" fill="none"><rect x="3" y="3" width="9" height="9" rx="1" stroke="currentColor"/><rect x="16" y="16" width="9" height="9" rx="1" stroke="currentColor"/><path d="M16 7h5v5M7 16v5h5" stroke="currentColor"/></svg></div><h3>{service.title}</h3><p class="service-problem">{service.problem}</p><p>{service.description}</p><div class="service-outcome"><span>THE OPPORTUNITY</span><p>{service.outcome}</p></div><ul>{service.examples.map(example=><li>{example}</li>)}</ul></article>)}</div>
    </div>
  </section>

  <section id="work" class="studio-section studio-dark work-section" aria-labelledby="work-title">
    <div class="studio-shell">
      <div class="section-heading"><div><p class="eyebrow">02 / Experience, put to work</p><h2 id="work-title">Real engineering.<br />Practical possibilities.</h2></div><p>A closer look at the systems I work on, and what those engineering patterns can do for a business like yours.</p></div>
      <p class="work-context">Professional experience and independent demonstrations. These are not Studio client engagements; all previews below use synthetic data.</p>
      <div class="work-grid">{caseStudies.map(study=><article class="work-card"><a class="work-image" href={`/studio/work/${study.slug}`} aria-label={`Explore ${study.title}`}><DemoPreview variant={study.variant} compact caption="" /></a><div class="work-meta"><span>{study.category}</span><span>{study.number}</span></div><h3><a href={`/studio/work/${study.slug}`}>{study.title} <span aria-hidden="true">↗</span></a></h3><p>{study.summary}</p><a href={`/studio/work/${study.slug}`} class="work-link">Explore the approach <span aria-hidden="true">→</span></a></article>)}</div>
    </div>
  </section>

  <section id="explorer" class="studio-section explorer-section" aria-label="Explore a business workflow"><div class="studio-shell"><WorkflowExplorer /></div></section>
  <section id="capabilities" class="studio-section studio-dark capabilities-section" aria-label="Engineering capabilities"><div class="studio-shell"><CapabilityMap /></div></section>

  <section class="studio-section process-section" aria-labelledby="process-title">
    <div class="studio-shell"><div class="section-heading"><div><p class="eyebrow">05 / How we work</p><h2 id="process-title">A clear process.<br />A direct conversation.</h2></div><p>You work directly with the engineer building your solution. Clear scope, useful prototypes, and regular conversations keep the work connected to what you actually need.</p></div><ol class="process-grid">{process.map(step=><li><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}</ol></div>
  </section>

  <section id="about" class="studio-section about-section" aria-labelledby="about-title">
    <div class="studio-shell about-grid"><div class="founder-image"><img src={founder.image} alt="Joe Quinn, founder of Quinn Software Studio" width="640" height="640" loading="lazy" decoding="async" /><span>THE ENGINEER BEHIND THE STUDIO</span></div><div class="about-copy"><p class="eyebrow">06 / Meet the founder</p><h2 id="about-title">Hi, I’m Joe.<br />I build for the real world.</h2><p class="about-intro">{founder.intro}</p>{founder.paragraphs.map(paragraph=><p>{paragraph}</p>)}<div class="experience-line"><span>Professional background</span><p>TrackMan <span aria-hidden="true">/</span> PGA TOUR ShotLink <span aria-hidden="true">/</span> Ohio State</p></div><a href="/" class="studio-text-link">Explore my technical portfolio <span aria-hidden="true">↗</span></a></div></div>
  </section>

  <section id="contact" class="studio-section studio-dark contact-section" aria-labelledby="contact-title">
    <div class="studio-shell contact-grid"><div class="contact-copy"><p class="eyebrow">07 / Start a conversation</p><h2 id="contact-title">What could<br />work <em>better?</em></h2><p>You don’t need a technical specification. Tell me what takes too much time, what keeps getting missed, or what your existing tools can’t do.</p><div class="contact-detail"><span>BASED IN PHOENIX. WORKING BEYOND IT.</span><a href={contact.emailHref}>{contact.email} <span aria-hidden="true">↗</span></a></div><p class="contact-small">A direct conversation with Joe. No account required.</p></div><ContactForm /></div>
  </section>
</StudioLayout>
<style>
.hero{padding-top:35px}.hero-topline{display:flex;align-items:center;justify-content:space-between;gap:20px}.hero-topline .eyebrow{font-size:.61rem;color:#5f625c;display:flex;align-items:center;gap:8px}.status-dot{width:6px;height:6px;background:#75827c;border-radius:50%}.portfolio-link{font-size:.7rem;color:#5f625c;display:flex;gap:28px;align-items:center;min-height:30px}.hero-grid{display:grid;grid-template-columns:1.07fr 1fr;gap:65px;align-items:start;padding:66px 0 70px}.hero h1{font-size:clamp(3.6rem,5.25vw,5.4rem);line-height:1.04;letter-spacing:-.065em;max-width:680px}.hero h1 em{font-style:normal;color:var(--studio-accent)}.hero-description{font-size:1rem;line-height:1.8;max-width:440px;margin-top:28px;color:#5f625c}.hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px;margin-top:32px}.hero-note{font-size:.7rem;line-height:1.7;margin-top:30px;color:#64675f}.hero-media{min-width:0;position:relative;padding-top:30px}.preview-label{display:flex;justify-content:space-between;gap:20px;font:500 .55rem var(--font-jetbrains-mono),monospace;letter-spacing:.12em;color:#666a61;margin-bottom:13px}.preview-cta{display:flex;justify-content:space-between;border-top:1px solid #c8c4b7;margin-top:20px;padding-top:17px;font-size:.72rem;color:#5f625c;min-height:44px}.hero-foot{border-top:1px solid var(--studio-line);display:flex;gap:50px;align-items:center;justify-content:space-between;padding:27px 0 36px}.hero-foot p{font-size:.7rem;color:#5f625c;line-height:1.7}.hero-foot strong{font-weight:500;color:#252a2c}.hero-foot ul{display:flex;gap:30px;align-items:center;list-style:none;padding:0;margin:0;font-size:.7rem;color:#5f625c}.hero-foot li{max-width:130px}.services-section{background:#e9e2d7;border-block:1px solid var(--studio-line)}.services-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #c8c2b8;border-left:1px solid #c8c2b8}.service{padding:27px 24px 24px;border-right:1px solid #c8c2b8;border-bottom:1px solid #c8c2b8;display:flex;flex-direction:column}.service-top{display:flex;justify-content:space-between;align-items:center;color:#8a4b30;margin-bottom:38px;font:500 .7rem var(--font-jetbrains-mono),monospace}.service h3{font-size:1.3rem;line-height:1.25;letter-spacing:-.035em;min-height:3.2rem}.service>p{font-size:.77rem;color:#5f625c;line-height:1.8;margin-top:12px}.service .service-problem{color:#252a2c;font-weight:500;min-height:4.1rem}.service-outcome{margin-top:24px;padding-top:20px;border-top:1px solid #cec7bc}.service-outcome>span{font:500 .55rem var(--font-jetbrains-mono),monospace;letter-spacing:.1em;color:#8a4b30}.service-outcome p{font-size:.76rem;margin-top:8px;line-height:1.75}.service ul{list-style:none;padding:20px 0 0;margin:auto 0 0;display:flex;flex-wrap:wrap;gap:6px}.service li{font-size:.57rem;padding:3px 7px;border:1px solid #c9c1b4;border-radius:3px;color:#5f625c}.work-context{font-size:.71rem;color:#bbc0b8;padding:18px 0 28px;border-top:1px solid #4c5352}.work-grid{display:grid;grid-template-columns:1fr 1fr;gap:54px 42px}.work-card{min-width:0}.work-image{display:block;border-radius:8px;overflow:hidden;background:#333b3b;padding:20px;transition:background .2s,transform .2s}.work-image:hover,.work-image:focus-visible{background:#3d4946;transform:translateY(-3px)}.work-meta{display:flex;justify-content:space-between;margin-top:24px;font:500 .59rem var(--font-jetbrains-mono),monospace;letter-spacing:.07em;text-transform:uppercase;color:#d8b895}.work-card h3{font-size:1.55rem;line-height:1.2;margin:12px 0 12px;letter-spacing:-.035em}.work-card h3 a{display:flex;align-items:flex-start;justify-content:space-between;gap:20px}.work-card h3 span{font-size:1.2rem;color:#d8b895}.work-card>p{font-size:.82rem;color:#bec1b9;line-height:1.8;max-width:510px}.work-link{display:inline-flex;gap:25px;align-items:center;margin-top:18px;min-height:44px;font-size:.75rem}.work-link:hover{color:#d8b895}.explorer-section{border-bottom:1px solid var(--studio-line)}.capabilities-section{background:#2c3530;border-bottom:1px solid #4a554c}.process-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:32px}.process-grid li{border-top:1px solid #bfb9ad;padding-top:25px}.step-number{display:block;font:500 .7rem var(--font-jetbrains-mono),monospace;color:#984725;margin-bottom:42px}.process-grid h3{font-size:1.23rem;max-width:220px;margin-bottom:17px;line-height:1.25}.process-grid p{font-size:.8rem;color:#5f625c;line-height:1.8}.about-section{border-top:1px solid var(--studio-line);background:#e9e2d7}.about-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:95px;align-items:center}.founder-image{max-width:410px}.founder-image img{display:block;width:100%;aspect-ratio:4/4.5;object-fit:cover;object-position:50% 35%;border-radius:6px;filter:saturate(.65)}.founder-image>span{display:block;font:500 .56rem var(--font-jetbrains-mono),monospace;letter-spacing:.12em;margin-top:16px;color:#5f625c}.about-copy h2{font-size:clamp(2.2rem,3.9vw,3.6rem);margin:20px 0 26px}.about-copy>p{font-size:.86rem;line-height:1.85;color:#5f625c;margin-bottom:16px}.about-copy>p.eyebrow{font-size:.65rem;color:#984725}.about-copy>p.about-intro{font-size:1.1rem;color:#252a2c;line-height:1.6}.experience-line{padding-block:18px;margin-top:18px;border-top:1px solid #c9c1b4}.experience-line>span{font-size:.62rem;color:#5f625c}.experience-line p{font-size:.73rem;margin-top:8px;display:flex;flex-wrap:wrap;gap:12px}.experience-line p span{color:#984725}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:start}.contact-copy h2{font-size:clamp(3rem,5.7vw,5.1rem);line-height:1.07;margin:25px 0}.contact-copy h2 em{font-style:normal;color:#d8b895}.contact-copy>p:not(.eyebrow){max-width:420px;font-size:.9rem;line-height:1.85;color:#c2c5bc}.contact-detail{margin-top:45px}.contact-detail>span{display:block;font:500 .55rem var(--font-jetbrains-mono),monospace;letter-spacing:.12em;color:#b1b8ac}.contact-detail a{display:inline-flex;gap:25px;align-items:center;margin-block:12px 20px;font-size:1.05rem}.contact-copy>p.contact-small{font-size:.7rem}
@media(min-width:1500px){.hero-grid{padding-top:90px;padding-bottom:90px;gap:85px}.hero h1{font-size:5.6rem}}
@media(max-width:1080px){.hero-grid{gap:35px}.hero h1{font-size:4rem}.services-grid{grid-template-columns:1fr 1fr}.service h3,.service .service-problem{min-height:0}.hero-foot{gap:30px}.hero-foot ul{gap:20px}.about-grid{gap:50px}.contact-grid{gap:50px}}
@media(max-width:760px){.hero{padding-top:22px}.hero-topline .eyebrow{font-size:.5rem;letter-spacing:.06em}.portfolio-link{font-size:.6rem;gap:5px}.hero-grid{grid-template-columns:1fr;gap:36px;padding:42px 0}.hero h1{font-size:clamp(3.1rem,10.5vw,4.7rem);max-width:600px}.hero-description{margin-top:22px;font-size:.95rem}.hero-actions{gap:20px;margin-top:26px}.hero-actions .studio-button{font-size:.75rem;padding:.8rem 1rem;gap:20px}.hero-actions .studio-text-link{font-size:.75rem;gap:10px}.hero-note{margin-top:22px}.hero-media{padding-top:0}.hero-foot{align-items:start;gap:24px}.hero-foot ul{display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:.58rem}.hero-foot p{font-size:.6rem;min-width:125px}.service{padding:24px 20px}.service-top{margin-bottom:25px}.work-grid{grid-template-columns:1fr;gap:38px}.work-image{padding:15px}.work-card h3{font-size:1.35rem}.process-grid{grid-template-columns:1fr 1fr;gap:30px 24px}.step-number{margin-bottom:28px}.about-grid{grid-template-columns:1fr;gap:35px}.founder-image{max-width:310px}.founder-image img{aspect-ratio:1/1}.contact-grid{grid-template-columns:1fr;gap:40px}.contact-detail{margin-top:28px}.contact-copy h2{font-size:3.7rem}}
@media(max-width:400px){.services-grid{grid-template-columns:1fr}.hero-foot{flex-direction:column;gap:18px}.hero-foot ul{width:100%;font-size:.65rem}.process-grid{grid-template-columns:1fr}.process-grid h3{max-width:none}.hero-actions{gap:12px}.contact-detail a{font-size:.9rem}}
@media(prefers-reduced-motion:reduce){.work-image:hover{transform:none}}
</style>
