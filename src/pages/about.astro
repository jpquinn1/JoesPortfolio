---
import Layout from '../layouts/Layout.astro';
import TechStack from '../components/TechStack.astro';
import '../styles/portfolio-work.css';
const experience = [
  { company: 'TrackMan', logo: '/images/logos/trackman.png', dates: 'March 2026 – Present', role: 'Operations Engineer — Software Development and Support', bullets: ['Engineering desktop tools for range design, radar data, and operator workflows.', 'Cloud-connected device control, telemetry, and alert-to-ticket automation.', 'macOS release maintenance, cross-platform packaging, and field troubleshooting.'] },
  { company: 'PGA TOUR · ShotLink', logo: '/images/logos/pga-tour.png', dates: 'March 2025 – February 2026', role: 'Technical Support Analyst / Development', bullets: ['Raspberry Pi provisioning, configuration tools, and AWS IoT integrations.', 'Tournament operations applications, API integrations, and radar telemetry.', 'Live-event technical monitoring and practical support for field teams.'] },
  { company: 'PGA TOUR · ShotLink', logo: '/images/logos/pga-tour.png', dates: 'May 2024 – March 2025', role: 'Field Technician', bullets: ['On-site tournament technology setup and troubleshooting.', 'Teamwork and technical communication in live production environments.'] },
];
---

<Layout title="Experience — Joe Quinn" description="Joe Quinn's experience connecting software, cloud services and field equipment at TrackMan and PGA TOUR ShotLink.">
  <header class="work-section work-page-header">
    <p class="section-label">About / Experience</p>
    <h1>Hands-on with<br />the whole system.</h1>
    <p class="experience-page-intro">I'm Joe, an engineer in Phoenix. I turn the realities of field operations into software people can use: clear interfaces, connected devices, and useful automation.</p>
    <div class="work-category-links"><a href="/projects">Explore my work <span>↗</span></a><a href="/resume">View resume <span>↗</span></a></div>
  </header>

  <section class="work-section" aria-labelledby="career-title">
    <div class="work-section-heading"><div><p class="section-label">Professional experience</p><h2 id="career-title">Built on real operations.</h2></div></div>
    <div class="experience-timeline">{experience.map((job) => <div class="experience-job"><div><img class="experience-job-logo" src={job.logo} alt={job.company} loading="lazy" width="75" height="48" /><p class="experience-job-date">{job.dates}</p></div><div><h3>{job.company}</h3><p class="experience-job-role">{job.role}</p><ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div></div>)}</div>
  </section>

  <section class="work-section work-personal-section" aria-labelledby="approach-title">
    <div class="experience-intro"><div><p class="section-label">How I work</p><h2 id="approach-title">Understand the problem.<br />Build the useful part.</h2></div><div><p>I like working across boundaries: equipment and software, field teams and developers, an unfamiliar domain and a repeatable workflow. That means learning the system, testing assumptions, and documenting the decisions that matter.</p><p class="mt-4">Alongside application development, I explore camera calibration, radar geometry, and CAD prototypes for field equipment.</p></div></div>
    <div class="focus-tools"><p class="work-fact-label">Regularly in the toolkit</p><TechStack tools={['python', 'typescript', 'react', 'aws', 'azure', 'docker', 'git']} /></div>
  </section>

  <section class="work-section work-personal-section" aria-labelledby="beyond-title">
    <div class="work-section-heading"><div><p class="section-label">Beyond the day job</p><h2 id="beyond-title">Stay curious.</h2></div><a class="work-text-link" href="/projects#personal">Personal projects <span aria-hidden="true">↗</span></a></div>
    <p class="work-section-intro">At home, I experiment with self-hosted services, music automation, and tools for everyday workflows. Outside the screen, you'll find photography, travel, and time outdoors.</p>
    <a class="work-text-link" href="/life">A little more of life <span aria-hidden="true">→</span></a>
    <div class="resume-education mt-8"><h3>The Ohio State University</h3><p>B.S. in Computer Science and Engineering · Graduated May 2024</p></div>
  </section>
</Layout>
