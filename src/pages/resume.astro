---
import Layout from '../layouts/Layout.astro';
import TechStack from '../components/TechStack.astro';
import { SOCIALS } from '../consts';
import '../styles/portfolio-work.css';

// Employment, education and leadership details retained from the existing resume.
// Project emphasis is updated from the November 2026 work inventory. The PDF is
// explicitly a separate June 2026 snapshot, not a synchronized export of this page.
const experience = [
  {
    company: 'TrackMan', location: 'Phoenix, AZ', dates: 'March 2026 – Present',
    role: 'Operations Engineer — Software Development and Support',
    bullets: [
      'Developed Range Studio, combining geospatial site data, shared radar-simulation services, and exportable reports in an internal desktop application.',
      'Built Grafana-to-Zendesk automation with asynchronous AWS processing, DynamoDB incident state, and support-context enrichment.',
      'Designed and implemented an Azure-connected radar-control system spanning firmware, provisioning, APIs, a dashboard, and desktop commissioning; engineering validation is ongoing.',
      'Maintain macOS releases of Range Support Tool 2, including packaging, signing, notarization, and cross-platform pipeline integration.',
      'Added ShotLink metadata indexing and Azure recording browsing to an existing broadcast-analysis workbench.',
    ],
  },
  {
    company: 'PGA TOUR — ShotLink', location: 'Ponte Vedra Beach, FL', dates: 'March 2025 – February 2026',
    role: 'Technical Support Analyst / Development',
    bullets: [
      'Built Raspberry Pi provisioning and fleet tooling around AWS IoT shadows, jobs, and release artifacts, with Python agents and operator interfaces.',
      'Developed desktop configuration tools for device selection, remote SSH actions, and field-equipment updates.',
      'Contributed schedule, reporting, device-integration, and deployment changes to shared operations applications.',
      'Extended radar telemetry and image collection with height mapping, configuration handling, and structured diagnostics; supported live tournament monitoring.',
    ],
  },
  {
    company: 'PGA TOUR — ShotLink', location: 'On-site (PGA TOUR, USGA, LPGA, Masters)', dates: 'May 2024 – March 2025',
    role: 'Field Technician',
    bullets: ['Supported on-site tournament technology and equipment.', 'Troubleshot live production issues through efficient teamwork and clear technical communication.'],
  },
];
const selected = [
  { title: 'Range Studio', href: '/projects/range-studio', detail: 'Desktop · Geospatial · Simulation integration' },
  { title: 'Radar relay IoT', href: '/projects/radar-relay-iot', detail: 'Embedded · Azure · Commissioning' },
  { title: 'Support automation', href: '/projects/grafana-zendesk-alert-automation', detail: 'AWS · Grafana · Zendesk' },
];
const coursework = 'Algorithms, Computer Networking, Network Security, Software Engineering, Systems, Computer Vision, Wireless Networks, Capstone: Knowledge Base Systems / RAG, Digital Logic Design, Process Engineering for Manufacturing Operations';
---

<Layout title="Resume — Joe Quinn" description="Joe Quinn's experience in software, connected field systems, cloud integrations and engineering tools.">
  <article class="work-section">
    <div class="flex flex-wrap items-center justify-between gap-4"><a href="/about" class="work-back-link">← About my experience</a><a href={SOCIALS.resumePdf} download class="work-text-link">June 2026 PDF <span aria-hidden="true">↓</span></a></div>
    <header class="work-page-header !px-0 !pt-10">
      <p class="section-label">Resume / November 2026</p>
      <h1>Joseph Quinn</h1>
      <p>Software &amp; connected field systems.</p>
      <p class="resume-summary">Operations engineer and Computer Science &amp; Engineering graduate. I build applications, device integrations, and support workflows for environments where equipment, data, and people need to work together.</p>
      <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-xs text-muted">
        <a href={SOCIALS.email} class="hover:text-accent">{SOCIALS.email.replace('mailto:', '')}</a>
        <a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-accent">LinkedIn ↗</a>
        <a href={SOCIALS.github} target="_blank" rel="noopener noreferrer" class="hover:text-accent">GitHub ↗</a>
      </div>
    </header>

    <section class="resume-section" aria-labelledby="resume-tools"><h2 id="resume-tools" class="section-label">Core toolkit</h2><TechStack tools={['python', 'typescript', 'react', 'fastapi', 'azure', 'aws', 'docker', 'terraform', 'postgresql', 'git']} /><p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted">Device provisioning and telemetry · Serverless APIs · Grafana / Prometheus / Splunk · Python desktop tools · C++ firmware · Cross-platform packaging</p></section>

    <section class="resume-section" aria-labelledby="resume-experience"><h2 id="resume-experience" class="section-label">Professional experience</h2><div class="experience-timeline">{experience.map((job) => <div class="experience-job"><div><p class="experience-job-date">{job.dates}</p><p class="mt-2 text-xs text-faint">{job.location}</p></div><div><h3>{job.company}</h3><p class="experience-job-role">{job.role}</p><ul>{job.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div></div>)}</div></section>

    <section class="resume-section" aria-labelledby="resume-projects"><h2 id="resume-projects" class="section-label">Selected professional work</h2><div class="resume-links">{selected.map((project) => <a href={project.href}>{project.title} ↗<span>{project.detail}</span></a>)}</div></section>

    <section class="resume-section" aria-labelledby="resume-personal"><h2 id="resume-personal" class="section-label">Personal projects</h2><p class="text-sm leading-relaxed text-muted">Application tracking with versioned resumes and analytics, self-hosted tools, and music automation. <a href="/projects#personal" class="text-accent hover:underline">Explore personal work →</a></p></section>

    <section class="resume-section" aria-labelledby="resume-education"><h2 id="resume-education" class="section-label">Education</h2><div class="resume-education"><h3>B.S., Computer Science and Engineering</h3><p>The Ohio State University — Columbus, OH<br />Graduated May 2024 · GPA: 3.6</p><details class="mt-5"><summary class="cursor-pointer font-mono text-xs text-accent">Relevant coursework</summary><p>{coursework}</p></details></div></section>

    <section class="resume-section" aria-labelledby="resume-leadership"><h2 id="resume-leadership" class="section-label">Leadership development</h2><div class="grid gap-5 sm:grid-cols-2"><div><h3 class="font-medium">ROTC</h3><p class="mt-2 text-sm leading-relaxed text-muted">Leadership, teamwork, and goal setting.<br />August 2019 – May 2020 · 2 semesters</p></div><div><h3 class="font-medium">Eagle Scout Project</h3><p class="mt-2 text-sm leading-relaxed text-muted">E-waste collection and promotion of responsible electronics disposal.</p></div></div></section>

    <footer class="mt-14 border-t border-border pt-7"><a href={SOCIALS.resumePdf} download class="work-text-link">Download June 2026 resume <span aria-hidden="true">↓</span></a><p class="resume-archive-note">The downloadable PDF is an earlier snapshot. This page includes more recent project work.</p></footer>
  </article>
</Layout>
