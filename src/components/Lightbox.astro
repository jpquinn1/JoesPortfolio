---
// Reusable, dependency-free image lightbox.
//
// Any element on the page rendered with these data attributes becomes a
// clickable trigger that opens a full-screen, zoomed-in view:
//   data-lightbox            -> marks the element as a trigger
//   data-lightbox-type       -> "image" (default) or "video"
//   data-lightbox-src        -> full/high-res image URL, or video URL
//   data-lightbox-alt        -> alt text for the large image
//   data-lightbox-caption    -> optional caption shown under the image/video
//   data-share-src           -> optional original-file URL for the Share button
//                               (falls back to hiding the button if absent)
//   data-share-file          -> filename used when sharing/downloading
//
// Triggers are collected in DOM order, so prev/next walks the whole page
// (across every trip / gallery section) naturally.
---

<div
	id="lightbox"
	class="lightbox"
	role="dialog"
	aria-modal="true"
	aria-label="Image viewer"
	aria-hidden="true"
>
	<button
		type="button"
		class="lightbox__close"
		data-lightbox-close
		aria-label="Close (Esc)">×</button
	>
	<button
		type="button"
		class="lightbox__nav lightbox__nav--prev"
		data-lightbox-prev
		aria-label="Previous image">‹</button
	>
	<button
		type="button"
		class="lightbox__nav lightbox__nav--next"
		data-lightbox-next
		aria-label="Next image">›</button
	>

	<figure class="lightbox__stage">
		<img class="lightbox__img" alt="" decoding="async" />
		<video class="lightbox__video" controls playsinline></video>
		<figcaption class="lightbox__caption"></figcaption>
	</figure>

	<button
		type="button"
		class="lightbox__share"
		data-lightbox-share
		aria-label="Share this photo or video"
	>
		<svg
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M4 12v7a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7" />
			<path d="M16 6l-4-4-4 4" />
			<path d="M12 2v13" />
		</svg>
		<span data-share-label>Share</span>
	</button>
</div>

<style>
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: none;
		align-items: center;
		justify-content: center;
		padding: clamp(1rem, 4vw, 3rem);
		background: rgba(5, 6, 8, 0.92);
		backdrop-filter: blur(6px);
		opacity: 0;
		transition: opacity 200ms ease;
	}

	.lightbox.is-open {
		display: flex;
		opacity: 1;
	}

	.lightbox__stage {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.85rem;
		max-width: 100%;
		max-height: 100%;
	}

	.lightbox__img,
	.lightbox__video {
		max-width: min(92vw, 1600px);
		max-height: 82vh;
		width: auto;
		height: auto;
		border-radius: 0.75rem;
		border: 1px solid var(--color-border);
		box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
		object-fit: contain;
	}

	.lightbox__video {
		display: none;
		background: #000;
	}

	.lightbox__caption {
		max-width: 64ch;
		text-align: center;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-muted);
	}

	.lightbox__caption:empty {
		display: none;
	}

	.lightbox__close,
	.lightbox__nav,
	.lightbox__share {
		position: absolute;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-fg);
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		cursor: pointer;
		line-height: 1;
		transition: background-color 150ms ease, border-color 150ms ease,
			transform 150ms ease;
	}

	.lightbox__close:hover,
	.lightbox__nav:hover,
	.lightbox__share:hover:not(:disabled) {
		background: rgba(255, 255, 255, 0.12);
		border-color: var(--color-border-strong);
	}

	.lightbox__close {
		top: clamp(0.75rem, 2vw, 1.5rem);
		right: clamp(0.75rem, 2vw, 1.5rem);
		width: 2.75rem;
		height: 2.75rem;
		font-size: 1.6rem;
	}

	.lightbox__nav {
		top: 50%;
		transform: translateY(-50%);
		width: 3rem;
		height: 3rem;
		font-size: 2rem;
		padding-bottom: 0.2rem;
	}

	.lightbox__nav:hover {
		transform: translateY(-50%) scale(1.05);
	}

	.lightbox__nav--prev {
		left: clamp(0.5rem, 2vw, 1.5rem);
	}

	.lightbox__nav--next {
		right: clamp(0.5rem, 2vw, 1.5rem);
	}

	.lightbox.is-single .lightbox__nav {
		display: none;
	}

	.lightbox__share {
		left: 50%;
		transform: translateX(-50%);
		/* Sits above the iOS home indicator via the safe-area inset. */
		bottom: calc(
			clamp(0.75rem, 2vw, 1.5rem) + env(safe-area-inset-bottom, 0px)
		);
		gap: 0.5rem;
		min-height: 2.75rem;
		padding: 0.6rem 1.2rem;
		font-size: 0.875rem;
		backdrop-filter: blur(6px);
	}

	.lightbox__share svg {
		width: 1.05rem;
		height: 1.05rem;
	}

	.lightbox__share:disabled {
		opacity: 0.6;
		cursor: wait;
	}

	.lightbox__share.is-hidden {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.lightbox {
			transition: none;
		}
	}
</style>

<script>
	import { prepareMediaFile, shareMedia } from '../scripts/share-media';

	const lb = document.getElementById('lightbox');

	if (lb) {
		const img = lb.querySelector('.lightbox__img') as HTMLImageElement | null;
		const video = lb.querySelector(
			'.lightbox__video',
		) as HTMLVideoElement | null;
		const caption = lb.querySelector(
			'.lightbox__caption',
		) as HTMLElement | null;
		const shareBtn = lb.querySelector(
			'[data-lightbox-share]',
		) as HTMLButtonElement | null;
		const shareLabel = shareBtn?.querySelector(
			'[data-share-label]',
		) as HTMLElement | null;
		const triggers = Array.from(
			document.querySelectorAll<HTMLElement>('[data-lightbox]'),
		);

		let current = -1;

		const shareFilename = (el: HTMLElement) =>
			el.dataset.shareFile ||
			el.dataset.shareSrc?.split('/').pop() ||
			'media';

		const resetShareButton = (el: HTMLElement) => {
			if (!shareBtn) return;
			shareBtn.classList.toggle('is-hidden', !el.dataset.shareSrc);
			shareBtn.disabled = false;
			if (shareLabel) shareLabel.textContent = 'Share';

			// Videos are large enough that fetching them on tap can outlast the
			// tap's share permission on iOS. They're already streaming for
			// playback, so warm the share file now; by the time someone taps
			// Share it resolves instantly. (Images stay lazy — they're small.)
			if (el.dataset.lightboxType === 'video' && el.dataset.shareSrc) {
				prepareMediaFile(el.dataset.shareSrc, shareFilename(el)).catch(
					() => {},
				);
			}
		};

		const open = (index: number) => {
			const el = triggers[index];
			if (!el) return;
			current = index;
			const src = el.dataset.lightboxSrc ?? '';
			const isVideo = el.dataset.lightboxType === 'video';

			if (isVideo && video) {
				if (img) {
					img.style.display = 'none';
					img.src = '';
				}
				video.style.display = 'block';
				video.src = src;
				video.play().catch(() => {});
			} else if (img) {
				if (video) {
					video.pause();
					video.removeAttribute('src');
					video.load();
					video.style.display = 'none';
				}
				img.style.display = 'block';
				img.src = src;
				img.alt = el.dataset.lightboxAlt ?? '';
			}

			if (caption) caption.textContent = el.dataset.lightboxCaption ?? '';
			resetShareButton(el);
			lb.classList.add('is-open');
			lb.classList.toggle('is-single', triggers.length < 2);
			lb.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
		};

		const close = () => {
			lb.classList.remove('is-open');
			lb.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
			current = -1;
			if (img) img.src = '';
			if (video) {
				video.pause();
				video.removeAttribute('src');
				video.load();
			}
		};

		const step = (delta: number) => {
			if (current < 0 || triggers.length === 0) return;
			open((current + delta + triggers.length) % triggers.length);
		};

		triggers.forEach((el, i) => {
			el.addEventListener('click', (e) => {
				e.preventDefault();
				open(i);
			});
		});

		lb.querySelector('[data-lightbox-close]')?.addEventListener(
			'click',
			close,
		);
		lb.querySelector('[data-lightbox-prev]')?.addEventListener('click', () =>
			step(-1),
		);
		lb.querySelector('[data-lightbox-next]')?.addEventListener('click', () =>
			step(1),
		);

		// Share the *original* media file (never the resized lightbox rendition)
		// through the native share sheet, or download it where unsupported.
		shareBtn?.addEventListener('click', async () => {
			const el = triggers[current];
			const src = el?.dataset.shareSrc;
			if (!el || !src || shareBtn.disabled) return;

			shareBtn.disabled = true;
			if (shareLabel) shareLabel.textContent = 'Preparing…';
			try {
				const outcome = await shareMedia(src, shareFilename(el));
				if (shareLabel) {
					// 'retry': the download took long enough that iOS no longer
					// trusts the original tap. The file is cached now, so a second
					// tap opens the share sheet instantly — say so instead of
					// failing silently.
					shareLabel.textContent =
						outcome === 'retry' ? 'Ready — tap to share' : 'Share';
				}
			} catch (err) {
				console.error('Share failed:', err);
				if (shareLabel) {
					shareLabel.textContent = 'Couldn’t share';
					window.setTimeout(() => {
						if (shareLabel) shareLabel.textContent = 'Share';
					}, 2000);
				}
			} finally {
				shareBtn.disabled = false;
			}
		});

		// Click on the dark backdrop (but not the image/controls) closes it.
		lb.addEventListener('click', (e) => {
			if (e.target === lb || e.target === lb.querySelector('.lightbox__stage'))
				close();
		});

		document.addEventListener('keydown', (e) => {
			if (!lb.classList.contains('is-open')) return;
			if (e.key === 'Escape') close();
			else if (e.key === 'ArrowLeft') step(-1);
			else if (e.key === 'ArrowRight') step(1);
		});
	}
</script>
