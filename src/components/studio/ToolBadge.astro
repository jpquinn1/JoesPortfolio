---
import ToolMark from './ToolMark.astro';
import { studioTools, type StudioTool } from '../../data/studio-tools';
interface Props { tool: StudioTool; compact?: boolean; }
const { tool, compact = false } = Astro.props;
const item = studioTools[tool];
---
<span class:list={['tool-badge', { compact }]}>
  <span class="tool-symbol"><ToolMark tool={tool} size={compact ? 15 : 21} /></span>
  <span>{item.name}</span>
</span>
<style>
  .tool-badge { display: inline-flex; align-items: center; gap: 10px; min-width: 0; color: var(--studio-fg); font: 500 .85rem/1.4 var(--font-inter),Arial,sans-serif; letter-spacing: .01em; }
  .tool-symbol { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 9px; background: #f8f7f2; border: 1px solid #d0cdc5; }
  .compact { gap: 7px; font-size: .75rem; color: var(--studio-muted); }.compact .tool-symbol { width: 26px; height: 26px; border-radius: 6px; }
</style>
