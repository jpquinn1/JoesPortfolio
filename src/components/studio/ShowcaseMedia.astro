---
import type { StudioMedia } from '../../data/studio-presentation';
interface Props { media?: StudioMedia; eager?: boolean; }
const { media, eager = false } = Astro.props;
---
{media?.kind === 'image' ? <img class="showcase-asset" src={media.src} alt={media.alt} width="1440" height="900" loading={eager ? 'eager' : 'lazy'} decoding="async" /> : media?.kind === 'video' ? <video class="showcase-asset" controls playsinline preload="metadata" poster={media.poster} aria-label={media.alt} width="1440" height="900"><source src={media.src} type="video/mp4" />{media.captions && <track kind="captions" src={media.captions} srclang="en" label="English" default />}<p><a href={media.src}>Download the demonstration</a></p></video> : <slot />}
<style>
  .showcase-asset{display:block;width:100%;height:100%;object-fit:contain;background:#e7e3d9}
</style>
