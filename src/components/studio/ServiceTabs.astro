---
import { servicePresentation } from '../../data/studio-presentation';
import ShowcaseMedia from './ShowcaseMedia.astro';
import ServiceVisual from './ServiceVisual.astro';
---
<div class="service-tabs" data-service-tabs>
  <div class="service-panels">
    {servicePresentation.map(service => <section class="service-panel" id={`service-panel-${service.id}`} data-service-panel={service.id} aria-label={service.label}>
      <ShowcaseMedia media={service.media}><ServiceVisual variant={service.preview} /></ShowcaseMedia>
    </section>)}
  </div>
  <div class="service-tablist" role="tablist" aria-label="What we build" hidden>
    {servicePresentation.map((service,index) => <button type="button" role="tab" id={`service-tab-${service.id}`} aria-controls={`service-panel-${service.id}`} aria-selected={String(index === 0)} tabindex={index === 0 ? 0 : -1} data-service-tab={service.id} data-caption={service.caption}>{service.label}</button>)}
  </div>
  <p class="service-caption" id="service-caption"><strong data-service-label>{servicePresentation[0].label}.</strong> <span data-service-description>{servicePresentation[0].caption}</span></p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-service-tabs]').forEach(root => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-service-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-service-panel]')];
    const select = (index: number, focus = false) => {
      tabs.forEach((tab,i) => { tab.setAttribute('aria-selected',String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
      panels.forEach((panel,i) => { panel.hidden = i !== index; });
      root.querySelector('[data-service-label]')!.textContent = `${tabs[index].textContent}.`;
      root.querySelector('[data-service-description]')!.textContent = tabs[index].dataset.caption!;
      if (focus) tabs[index].focus();
    };
    panels.forEach((panel,i) => { panel.setAttribute('role','tabpanel'); panel.setAttribute('aria-labelledby',tabs[i].id); panel.setAttribute('aria-describedby','service-caption'); panel.tabIndex = 0; });
    tabs.forEach((tab,index) => {
      tab.addEventListener('click',() => select(index));
      tab.addEventListener('keydown',event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault(); select(next,true);
      });
    });
    root.querySelector<HTMLElement>('[role="tablist"]')!.hidden = false;
    select(0);
  });
</script>
<style>
  [hidden]{display:none!important}.service-panels{border-radius:22px;overflow:hidden;background:#e7e5da;border:1px solid #75827c24}.service-panel{min-height:520px}.service-panel+.service-panel:not([hidden]){border-top:1px solid #75827c44}.service-panel:focus-visible{outline-offset:-5px}.service-panel :global(>.showcase-asset){height:560px;object-fit:cover}.service-tablist{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;width:fit-content;max-width:100%;gap:4px;padding:6px;margin:25px auto 0;border-radius:30px;background:#e6e0d5}.service-tablist button{border:0;border-radius:23px;min-height:44px;padding:10px 19px;background:transparent;color:#575e53;font-size:.77rem;white-space:nowrap;transition:background .2s,color .2s}.service-tablist button:hover{color:#252a2c;background:#d7d9cc}.service-tablist button[aria-selected="true"]{background:#29352e;color:#f1e9dd}.service-caption{max-width:760px;min-height:3.2em;margin:22px auto 0;text-align:center;font-size:.91rem;line-height:1.7;color:#73776c}.service-caption strong{font-weight:500;color:#333d32}.service-panel :global(.demo-shell){box-shadow:none}
  @media(max-width:850px){.service-panel{min-height:440px}.service-tablist button{padding-inline:14px;font-size:.7rem}}
  @media(max-width:600px){.service-panel{min-height:390px}.service-panel :global(>.showcase-asset){height:390px}.service-tablist{display:grid;grid-template-columns:1fr 1fr;width:100%;border-radius:20px;margin-top:18px}.service-tablist button{white-space:normal;padding:9px 10px;font-size:.7rem;line-height:1.4;border-radius:16px}.service-caption{font-size:.82rem;margin-top:18px;min-height:5em}.service-panels{border-radius:16px}}
  @media(prefers-reduced-motion:reduce){.service-tablist button{transition:none}}
</style>
