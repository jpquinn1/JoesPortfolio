---
import ToolBadge from './ToolBadge.astro';
import Icon from './WorkflowIcon.astro';
---
<figure class="tool-connections" data-tool-connections data-running="false" aria-label="Example: spreadsheet rows are checked and assigned, then sent to a team or email update">
  <figcaption><div><p class="eyebrow">Your everyday tools</p><h3>From spreadsheet to next step.</h3></div><button type="button" data-flow-toggle hidden>Pause flow</button></figcaption>
  <div class="tool-pipeline">
    <div class="tool-endpoints inputs"><div><ToolBadge tool="excel" /><small>A new row</small></div><div><ToolBadge tool="sheets" /><small>A form response</small></div></div>
    <div class="pipeline-link" aria-hidden="true"><span></span><i></i></div>
    <div class="pipeline-action"><span class="automation-symbol"><Icon name="workflow" size={28} /></span><div><strong>Check & assign</strong><span>One clear next step</span></div><span class="action-check" aria-hidden="true">✓</span></div>
    <div class="pipeline-link second-link" aria-hidden="true"><span></span><i></i></div>
    <div class="tool-endpoints outputs"><div><ToolBadge tool="slack" /><small>Notify your team</small></div><div><ToolBadge tool="gmail" /><small>Send an update</small></div></div>
  </div>
  <p class="connection-note">Illustrative connections · We’ll check what your tools support.</p>
</figure>
<script>
  document.querySelectorAll<HTMLElement>('[data-tool-connections]').forEach(root => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-flow-toggle]')!;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = preference.matches;
    let visible = false;
    const sync = () => {
      root.dataset.running = String(!paused && !preference.matches && visible && !document.hidden);
      toggle.disabled = preference.matches;
      toggle.textContent = preference.matches ? 'Reduced motion' : paused ? 'Play flow' : 'Pause flow';
    };
    toggle.hidden = false;
    toggle.addEventListener('click', () => { paused = !paused; sync(); });
    preference.addEventListener('change', () => { paused = preference.matches; sync(); });
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver(entries => { visible = entries.some(entry => entry.isIntersecting); sync(); }, { threshold: .15 }).observe(root);
    addEventListener('pagehide', () => { visible = false; sync(); });
    addEventListener('pageshow', () => { const box = root.getBoundingClientRect(); visible = box.bottom > 0 && box.top < innerHeight; sync(); });
    sync();
  });
</script>
<style>
  .tool-connections { margin-top: 38px; padding: 28px; border: 1px solid var(--studio-border); border-radius: 12px; background: var(--studio-inset); }
  figcaption { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
  figcaption .eyebrow { font-size: .65rem; margin-bottom: 8px; }figcaption h3 { font-size: 1.2rem; line-height: 1.4; letter-spacing: -.02em; }
  figcaption button { flex: none; min-height: 44px; border: 0; background: none; color: var(--studio-muted); font: .7rem/1.6 var(--pitch-mono); text-decoration: underline; text-underline-offset: 5px; }button[hidden] { display: none; }button:disabled { text-decoration: none; cursor: default; }
  .tool-pipeline { display: grid; grid-template-columns: 1fr 65px 1.1fr 65px 1fr; align-items: center; }
  .tool-endpoints { display: grid; gap: 12px; }.tool-endpoints>div { display: grid; gap: 6px; padding: 12px 15px; border: 1px solid var(--studio-border); border-radius: 9px; background: var(--studio-bg); }.tool-endpoints small { color: var(--studio-muted); font-size: .75rem; padding-left: 46px; }
  .pipeline-action { display: flex; align-items: center; gap: 13px; padding: 24px 17px; position: relative; border: 1px solid var(--studio-accent-line); border-radius: 11px; background: var(--studio-accent-soft); }
  .automation-symbol { display: grid; place-items: center; color: var(--studio-accent); flex: none; }.pipeline-action strong { display: block; font: 500 .85rem/1.5 var(--pitch-mono); }.pipeline-action div>span { display: block; font-size: .75rem; color: var(--studio-muted); margin-top: 5px; }
  .action-check { position: absolute; right: -7px; top: -7px; display: grid; place-items: center; width: 22px; height: 22px; background: var(--studio-accent); color: var(--studio-bg); border-radius: 50%; animation: pipeline-check 7s infinite; }
  .pipeline-link { position: relative; height: 28px; }.pipeline-link span { position: absolute; inset: 50% 0 auto; height: 1px; background: var(--studio-accent-line); }.pipeline-link i { position: absolute; top: 11px; left: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--studio-accent); box-shadow: 0 0 0 4px #23685d10; animation: pipeline-packet 7s infinite; }
  .second-link span { transform: scaleX(-1); }.second-link i { animation-delay: 2.4s; }
  .outputs>div { animation: pipeline-delivered 7s infinite; }.outputs>div:last-child { animation-delay: .2s; }
  .connection-note { font-size: .73rem; color: var(--studio-muted); margin-top: 24px; }
  [data-running="false"] * { animation-play-state: paused !important; }
  @keyframes pipeline-packet { 0%,10% { opacity: 0; left: 0; } 15% { opacity: 1; } 38% { opacity: 1; left: calc(100% - 6px); } 42%,100% { opacity: 0; left: calc(100% - 6px); } }
  @keyframes pipeline-check { 0%,35%,90%,100% { opacity: 0; transform: scale(.7); } 41%,84% { opacity: 1; transform: scale(1); } }
  @keyframes pipeline-delivered { 0%,70%,100% { border-color: var(--studio-border); box-shadow: none; } 77%,86% { border-color: var(--studio-accent-line); box-shadow: 0 0 0 3px #23685d0a; } }
  @media(max-width:1000px) { .tool-pipeline { grid-template-columns: 1fr 30px 1.1fr 30px 1fr; }.pipeline-action { flex-direction: column; text-align: center; padding: 20px 12px; }.tool-endpoints>div { padding: 12px; }.tool-endpoints small { padding-left: 0; } }
  @media(max-width:600px) { .tool-connections { padding: 23px 20px; }figcaption { align-items: flex-start; margin-bottom: 24px; }figcaption h3 { font-size: 1.08rem; }figcaption button { font-size: .65rem; }.tool-pipeline { grid-template-columns: 1fr; }.tool-endpoints { grid-template-columns: 1fr 1fr; gap: 10px; }.tool-endpoints>div { padding: 12px 10px; }.tool-endpoints :global(.tool-badge) { flex-direction: column; align-items: flex-start; gap: 8px; font-size: .8rem; }.tool-endpoints small { font-size: .7rem; }.pipeline-link { width: 28px; height: 36px; justify-self: center; }.pipeline-link span { inset: 0 auto 0 50%; height: 100%; width: 1px; }.pipeline-link i { left: 11px; top: 0; animation-name: pipeline-packet-down; }.second-link span { transform: scaleY(-1); }.pipeline-action { flex-direction: row; text-align: left; justify-content: center; padding: 20px; }.connection-note { font-size: .7rem; } }
  @keyframes pipeline-packet-down { 0%,10% { opacity: 0; top: 0; } 15% { opacity: 1; } 38% { opacity: 1; top: calc(100% - 6px); } 42%,100% { opacity: 0; top: calc(100% - 6px); } }
  @media(prefers-reduced-motion:reduce) { * { animation: none !important; }.pipeline-link i { display: none; } }
</style>
