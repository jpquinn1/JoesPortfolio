---
import Icon from './WorkflowIcon.astro';
const examples = [
  {
    id: 'requests', label: 'Forms & admin', icon: 'form',
    email: '“Can you book this in?”', sheet: 'jobs_final_v3.xlsx', note: 'Who’s handling this?',
    before: 'Email + spreadsheet', after: 'Form + work queue',
    title: 'New service request', subtitle: 'Request details and assignment.',
    field: 'Service needed', value: 'Equipment maintenance',
    result: 'Request received. Team assigned.', stages: ['Capture the details', 'Create the job', 'Confirm with the client'],
    outcome: 'Capture details once, then create a job and notify the team without re-entering the same information.',
  },
  {
    id: 'clients', label: 'Client workflows', icon: 'client',
    email: '“Any update on my project?”', sheet: 'client_followups.xlsx', note: 'Did we reply yet?',
    before: 'Separate email threads', after: 'Shared client portal',
    title: 'Client project portal', subtitle: 'A simple portal for your clients.',
    field: 'Next step', value: 'Review your proposal',
    result: 'Proposal ready. Client notified.', stages: ['Welcome the client', 'Share the next step', 'Keep them updated'],
    outcome: 'Share progress, documents, and next steps in one place, with client updates tied to the workflow.',
  },
  {
    id: 'signals', label: 'Telemetry', icon: 'signal',
    email: '“Is the unit still running?”', sheet: 'equipment_checks.xlsx', note: 'Last checked… when?',
    before: 'Manual equipment checks', after: 'Telemetry + alerts',
    title: 'Equipment overview', subtitle: 'Device status, readings, and alerts.',
    field: 'Latest reading', value: '26.4 °C · just received',
    result: 'Temperature alert. Check assigned.', stages: ['Collect a reading', 'Spot a change', 'Notify the right person'],
    outcome: 'Collect equipment readings, track changes over time, and route alerts to the right person.',
  },
];
---
<div class="operations-demo" data-operations-demo>
  <div class="demo-toolbar">
    <div class="demo-tabs" role="tablist" aria-label="Explore a better workflow">
      {examples.map((example, index) => <button type="button" role="tab" id={`workflow-tab-${example.id}`} aria-controls={`workflow-panel-${example.id}`} aria-selected={String(index === 0)} tabindex={index === 0 ? 0 : -1} disabled>
        <Icon name={example.icon} size={17} /><span>{example.label}</span>
      </button>)}
    </div>
    <button type="button" class="motion-toggle" data-studio-motion-toggle hidden><span aria-hidden="true">Ⅱ</span><span data-motion-label>Pause motion</span></button>
  </div>
  {examples.map((example, index) => <div class="workflow-panel" id={`workflow-panel-${example.id}`} role="tabpanel" aria-labelledby={`workflow-tab-${example.id}`} tabindex="0" hidden={index !== 0}>
    <div class="workflow-comparison">
      <div class="workflow-before">
        <p class="stage-label"><span>Before</span> {example.before}</p>
        <div class="scattered-work" aria-label="Scattered emails, spreadsheets, and handwritten reminders">
          <div class="paper-email"><span class="paper-icon"><Icon name="mail" size={18} /></span><div><span class="paper-kicker">Inbox · unread</span><strong>{example.email}</strong></div><i></i></div>
          <div class="paper-sheet"><div><Icon name="sheet" size={16} /><span>{example.sheet}</span></div><div class="sheet-cells" aria-hidden="true">{Array.from({length: 15}, (_, i) => <span class:list={{ 'cell-filled': i === 1 || i === 7 || i === 10 }}></span>)}</div></div>
          <div class="paper-note"><span class="note-pin" aria-hidden="true"></span><Icon name="clock" size={18} /><strong>{example.note}</strong><span class="note-line" aria-hidden="true"></span></div>
          <svg class="tangle" viewBox="0 0 400 240" fill="none" aria-hidden="true"><path d="M70 60C250 5 350 55 270 126S75 220 100 145 290 95 350 195" stroke="currentColor" stroke-dasharray="4 7" /></svg>
        </div>
      </div>
      <div class="workflow-bridge" aria-hidden="true"><span class="bridge-line"></span><span class="bridge-mark"><svg width="30" height="30" viewBox="0 0 40 40" fill="none"><rect x="4" y="4" width="29" height="29" rx="9" stroke="currentColor" stroke-width="3" /><path d="M24 24L36 36" stroke="currentColor" stroke-width="3" /></svg></span><span class="bridge-line bridge-line-out"></span></div>
      <div class="workflow-after">
        <p class="stage-label"><span>After</span> {example.after}</p>
        <div class="organized-work">
          <div class="mini-app-heading"><span class="app-icon"><Icon name={example.icon} size={21} /></span><div><strong>{example.title}</strong><span>{example.subtitle}</span></div><span class="app-menu" aria-hidden="true">···</span></div>
          {example.id === 'signals' ? <div class="demo-telemetry"><div><span>Workshop sensor</span><strong>26.4 <small>°C</small></strong></div><svg viewBox="0 0 230 58" role="img" aria-label="Example temperature rises and crosses an alert threshold"><path d="M0 22H230" stroke="var(--studio-warning)" stroke-dasharray="4 5"/><path class="mini-chart" d="M0 48 18 45 34 48 52 39 70 42 87 33 105 35 123 26 142 30 160 20 178 22 194 11 212 14 230 6" fill="none" stroke="var(--studio-accent)" stroke-width="2.5"/></svg></div> : <div class="mini-form"><div><span>{example.id === 'clients' ? 'Client' : 'Company'}</span><strong>Northside Co.</strong></div><div><span>{example.field}</span><strong>{example.value}</strong></div></div>}
          <div class="mini-result"><span class="result-check"><Icon name="check" size={15} /></span>{example.result}</div>
        </div>
        <ol class="workflow-stages">{example.stages.map((stage, i) => <li style={`--stage: ${i}`}><span><Icon name="check" size={12} /></span>{stage}</li>)}</ol>
      </div>
    </div>
    <div class="demo-caption"><span><Icon name="arrow" size={16} />{example.outcome}</span><small>Illustrative workflow · sample data</small></div>
  </div>)}
  <noscript><p class="demo-fallback">Example: a single request form can create a job, assign your team, and confirm the next step with your client.</p></noscript>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-operations-demo]').forEach(root => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute('aria-selected', String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
    };
    tabs.forEach((tab, index) => {
      tab.disabled = false;
      tab.addEventListener('click', () => select(index));
      tab.addEventListener('keydown', event => {
        let next = index;
        if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') next = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === 'Home') next = 0;
        else if (event.key === 'End') next = tabs.length - 1;
        else return;
        event.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });
  });
</script>

<style>
  [hidden] { display: none !important; }
  .operations-demo { text-align: left; border: 1px solid var(--studio-border); border-radius: 10px; background: var(--studio-surface); box-shadow: 0 18px 65px var(--studio-shadow); overflow: hidden; }
  .demo-toolbar { padding: 10px 18px; border-bottom: 1px solid var(--studio-border); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .demo-tabs { display: flex; gap: 5px; }
  .demo-tabs button { display: flex; gap: 9px; align-items: center; padding: 10px 13px; min-height: 44px; border: 1px solid transparent; border-radius: 6px; background: transparent; color: var(--studio-muted); font-size: .75rem; font-weight: 500; }
  .demo-tabs button[aria-selected="true"] { background: var(--studio-accent-soft); border-color: var(--studio-accent-line); color: var(--studio-accent); }
  .demo-tabs button:hover { color: var(--studio-fg); background: var(--studio-raised); }
  .motion-toggle { display: flex; gap: 7px; align-items: center; min-height: 44px; flex: none; border: 0; background: transparent; color: var(--studio-muted); font: .6rem var(--font-jetbrains-mono), monospace; }
  .motion-toggle:disabled { cursor: default; }
  .workflow-panel:focus-visible { outline-offset: -5px; }
  .workflow-comparison { display: grid; grid-template-columns: 1fr 84px 1.13fr; padding: 28px 32px 18px; }
  .stage-label { display: flex; align-items: baseline; gap: 12px; color: var(--studio-muted); font-size: .72rem; line-height: 1.6; }
  .stage-label>span { color: var(--studio-faint); font: 500 .62rem var(--font-jetbrains-mono), monospace; letter-spacing: .07em; text-transform: uppercase; }
  .workflow-after .stage-label>span { color: var(--studio-accent); }
  .scattered-work { position: relative; height: 239px; max-width: 410px; margin: 13px auto 0; }
  .paper-email { position: absolute; top: 12px; left: 6px; z-index: 2; display: flex; align-items: center; gap: 12px; width: 91%; padding: 15px; border: 1px solid var(--studio-border); background: var(--studio-raised); border-radius: 7px; box-shadow: 0 8px 15px var(--studio-shadow); transform: rotate(-5deg); }
  .paper-icon { display: grid; place-items: center; width: 32px; height: 32px; background: var(--studio-raised); border-radius: 7px; color: var(--studio-muted); flex: none; }
  .paper-kicker { display: block; font: .52rem var(--font-jetbrains-mono),monospace; color: var(--studio-muted); margin-bottom: 4px; }
  .paper-email strong { font-size: .72rem; font-weight: 500; }
  .paper-email i { width: 5px; height: 5px; border-radius: 50%; background: var(--studio-warning); margin-left: auto; flex: none; }
  .paper-sheet { position: absolute; top: 96px; right: 2px; width: 73%; border: 1px solid var(--studio-border); border-radius: 6px; overflow: hidden; transform: rotate(4deg); background: var(--studio-surface); z-index: 1; }
  .paper-sheet>div:first-child { display: flex; align-items: center; gap: 9px; padding: 9px 12px; background: var(--studio-raised); color: var(--studio-muted); font: .56rem var(--font-jetbrains-mono),monospace; }
  .sheet-cells { display: grid; grid-template-columns: 1fr 1.6fr 1fr; }
  .sheet-cells span { height: 16px; border-right: 1px solid var(--studio-border); border-top: 1px solid var(--studio-border); }
  .sheet-cells .cell-filled::after { content: ''; display: block; margin: 6px 10px; height: 3px; background: var(--studio-border-strong); border-radius: 2px; }
  .paper-note { position: absolute; bottom: 0; left: 14px; width: 137px; display: grid; gap: 9px; padding: 20px 15px 15px; background: var(--studio-raised); color: var(--studio-fg); transform: rotate(-7deg); z-index: 3; box-shadow: 0 9px 15px var(--studio-shadow); }
  .paper-note strong { font-size: .75rem; font-weight: 500; line-height: 1.4; }
  .note-pin { position: absolute; width: 35px; height: 13px; background: #3a465390; left: 47px; top: -5px; transform: rotate(6deg); }
  .note-line { width: 65%; border-top: 1px solid var(--studio-border); }
  .tangle { position: absolute; inset: 0; width: 100%; height: 100%; color: var(--studio-border-strong); }
  .workflow-bridge { display: flex; align-items: center; justify-content: center; padding-top: 22px; }
  .bridge-mark { display: grid; place-items: center; height: 53px; width: 53px; flex: none; border-radius: 50%; background: var(--studio-accent-soft); color: var(--studio-accent); box-shadow: 0 0 0 7px var(--studio-inset); z-index: 1; }
  .bridge-line { height: 1px; background: var(--studio-border); width: 100%; position: relative; }
  .bridge-line-out { background: var(--studio-accent); }
  .bridge-line-out::after { content: ''; position: absolute; width: 5px; height: 5px; border-radius: 50%; background: var(--studio-accent); top: -2px; animation: transfer 3s ease-in-out infinite; }
  .organized-work { margin-top: 23px; padding: 20px; border: 1px solid var(--studio-accent-line); border-radius: 10px; background: var(--studio-surface); box-shadow: 0 8px 20px var(--studio-shadow); }
  .mini-app-heading { display: flex; align-items: center; gap: 11px; }
  .app-icon { display: grid; place-items: center; width: 37px; height: 37px; border-radius: 9px; color: var(--studio-accent); background: var(--studio-accent-soft); flex: none; }
  .mini-app-heading strong { display: block; font-size: .83rem; font-weight: 600; }
  .mini-app-heading div>span { display: block; font-size: .6rem; margin-top: 3px; color: var(--studio-muted); }
  .app-menu { margin-left: auto; color: var(--studio-muted); font-size: 1.2rem; }
  .mini-form { display: grid; grid-template-columns: 1fr 1.25fr; gap: 12px; margin: 20px 0 16px; }
  .mini-form div>span { display: block; font-size: .57rem; color: var(--studio-muted); margin-bottom: 6px; }
  .mini-form strong { display: block; border: 1px solid var(--studio-border); border-radius: 5px; background: var(--studio-inset); padding: 10px; font-size: .66rem; font-weight: 400; }
  .mini-result { display: flex; align-items: center; gap: 8px; border-top: 1px solid var(--studio-border); padding-top: 13px; color: var(--studio-accent); font-size: .65rem; }
  .result-check { display: grid; place-items: center; border-radius: 50%; width: 22px; height: 22px; background: var(--studio-accent-soft); flex: none; }
  .workflow-stages { padding: 0; margin: 17px 0 0; display: flex; justify-content: space-between; gap: 10px; list-style: none; }
  .workflow-stages li { display: flex; gap: 6px; align-items: center; font-size: .59rem; color: var(--studio-muted); }
  .workflow-stages li>span { display: grid; place-items: center; width: 18px; height: 18px; flex: none; border: 1px solid var(--studio-accent-line); border-radius: 50%; animation: stage-glow 6s ease-in-out infinite; animation-delay: calc(var(--stage) * 1s); }
  .demo-telemetry { display: flex; align-items: center; gap: 20px; margin: 19px 0 15px; }
  .demo-telemetry>div { flex: none; }.demo-telemetry span { display: block; font-size: .56rem; color: var(--studio-muted); }.demo-telemetry strong { font: 500 1.65rem var(--font-jetbrains-mono),monospace; color: var(--studio-accent); }.demo-telemetry small { font-size: .8rem; }.demo-telemetry svg { width: 58%; flex: 1; min-width: 0; }
  .mini-chart { stroke-dasharray: 270; animation: draw-reading 6s ease-out infinite; }
  .demo-caption { display: flex; justify-content: space-between; align-items: center; gap: 18px; padding: 16px 27px; border-top: 1px solid var(--studio-border); background: var(--studio-raised); }
  .demo-caption>span { display: flex; align-items: center; gap: 12px; font-size: .76rem; line-height: 1.7; color: var(--studio-muted); max-width: 690px; }
  .demo-caption>span :global(svg) { color: var(--studio-accent); flex: none; }
  .demo-caption small { flex: none; font: .52rem var(--font-jetbrains-mono),monospace; color: var(--studio-muted); }
  .demo-fallback { padding: 18px; font-size: .8rem; }
  @keyframes transfer { 0%,15% { left: 0; opacity: 0; } 25% { opacity: 1; } 85%,100% { left: 100%; opacity: 0; } }
  @keyframes stage-glow { 0%,15%,65%,100% { background: transparent; } 30%,45% { background: var(--studio-accent-soft); border-color: var(--studio-accent-line); } }
  @keyframes draw-reading { 0% { stroke-dashoffset: 270; } 60%,100% { stroke-dashoffset: 0; } }
  @media(max-width:1000px) { .workflow-comparison { padding: 25px 22px 18px; grid-template-columns: 1fr 65px 1.1fr; }.stage-label { flex-direction: column; gap: 4px; }.mini-form { grid-template-columns: 1fr; gap: 7px; margin: 12px 0; }.mini-form div { display: flex; align-items: center; gap: 10px; }.mini-form div>span { width: 75px; margin: 0; flex: none; }.mini-form strong { flex: 1; padding: 7px; }.workflow-stages { flex-direction: column; gap: 5px; }.organized-work { padding: 16px; }.mini-app-heading div>span { line-height: 1.5; }.scattered-work { margin-top: 30px; }.demo-caption small { max-width: 145px; text-align: right; } }
  @media(max-width:680px) { .demo-toolbar { flex-direction: column; align-items: stretch; padding: 8px 10px 0; gap: 0; }.demo-tabs { justify-content: space-between; gap: 3px; }.demo-tabs button { flex: 1; justify-content: center; flex-direction: column; gap: 6px; padding: 8px 4px; font-size: .65rem; line-height: 1.5; }.motion-toggle { align-self: flex-end; min-height: 35px; }.workflow-comparison { grid-template-columns: 1fr; padding: 20px; }.stage-label { flex-direction: row; gap: 12px; flex-wrap: wrap; font-size: .67rem; }.scattered-work { height: 200px; max-width: 320px; width: 100%; margin-top: 10px; }.paper-email { top: 10px; padding: 12px; }.paper-note { width: 120px; padding: 16px 12px 12px; }.paper-note strong { font-size: .68rem; }.paper-sheet { top: 85px; }.sheet-cells span { height: 14px; }.workflow-bridge { height: 73px; padding: 0; transform: rotate(90deg); width: 75px; justify-self: center; }.bridge-mark svg { transform: rotate(-90deg); }.bridge-mark { width: 43px; height: 43px; }.bridge-mark svg { width: 25px; }.organized-work { margin-top: 15px; }.mini-form { grid-template-columns: 1fr 1.3fr; gap: 10px; margin: 18px 0 15px; }.mini-form div { display: block; }.mini-form div>span { width: auto; margin-bottom: 6px; }.mini-form strong { font-size: .62rem; padding: 8px; }.workflow-stages { flex-direction: row; gap: 8px; }.workflow-stages li { font-size: .52rem; line-height: 1.4; }.demo-caption { flex-direction: column; align-items: flex-start; gap: 9px; padding: 15px 20px; }.demo-caption>span { font-size: .68rem; }.demo-caption small { max-width: none; text-align: left; font-size: .49rem; }.mini-app-heading strong { font-size: .8rem; } }
  @media(prefers-reduced-motion:reduce) { .mini-chart { animation: none; stroke-dashoffset: 0; }.bridge-line-out::after,.workflow-stages li>span { animation: none; } }
</style>
