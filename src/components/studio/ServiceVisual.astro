---
interface Props { variant: 'software' | 'automation' | 'integration' | 'equipment'; }
const { variant } = Astro.props;
---
<div class:list={['service-visual', `visual-${variant}`]}>
  {variant === 'software' || variant === 'equipment' ? <div class="interface-preview" role="img" aria-label={variant === 'software' ? 'Concept application showing a simple shared work queue.' : 'Concept equipment dashboard showing three connected devices.'}>
    <div class="mock-topbar"><span class="mock-brand" aria-hidden="true">Q<span>·</span></span><span>{variant === 'software' ? 'WORKSPACE' : 'FIELD SYSTEMS'}</span><span class="mock-connected">● Connected</span></div>
    <div class="mock-content"><p class="mock-kicker">{variant === 'software' ? 'YOUR TEAM. ONE VIEW.' : 'INFORMATION FROM THE FIELD.'}</p><h3>{variant === 'software' ? 'A clearer working day.' : 'Know what’s happening.'}</h3>
    {variant === 'software' ? <><div class="mock-metrics"><div><strong>12</strong><span>Open jobs</span></div><div><strong>05</strong><span>In progress</span></div><div><strong>02</strong><span>To review</span></div></div><div class="mock-queue"><div><span><i></i>Service request</span><span>Ready</span></div><div><span><i></i>Inventory update</span><span>Assigned</span></div><div><span><i></i>Equipment check</span><span>In progress</span></div></div></> : <div class="mock-equipment">{[{label:'Temperature',value:'24.6',unit:'°C',points:'0,34 15,27 30,30 45,18 60,22 75,17 90,20 105,12 120,16'},{label:'Power',value:'12.4',unit:'V',points:'0,24 15,21 30,24 45,19 60,21 75,18 90,22 105,19 120,20'},{label:'Fan speed',value:'1,240',unit:'rpm',points:'0,35 15,31 30,28 45,29 60,22 75,25 90,17 105,21 120,18'}].map(item=><div><span class="equipment-online">● ONLINE</span><h4>{item.label}</h4><p>{item.value}<small>{item.unit}</small></p><svg viewBox="0 0 120 48" aria-hidden="true"><path d="M0 44H120M0 22H120" stroke="#66785a" stroke-width=".5"/><polyline points={item.points} fill="none" stroke="#b7c5a5" stroke-width="1.7"/></svg></div>)}</div>}
    </div>
  </div> : variant === 'automation' ? <div class="flow-illustration" role="img" aria-label="A concept workflow connecting a request, human review, and a completed job.">
    <div class="flow-card"><span class="flow-icon" aria-hidden="true">↳</span><span class="flow-step">01 / INTAKE</span><h3>A request comes in.</h3><div class="fake-lines" aria-hidden="true"><i></i><i></i><i></i></div><span class="flow-status">Details captured</span></div>
    <span class="flow-connector" aria-hidden="true">→</span>
    <div class="flow-card flow-review"><span class="flow-icon" aria-hidden="true">◎</span><span class="flow-step">02 / HUMAN REVIEW</span><h3>The right person decides.</h3><div class="review-checks"><span>✓ Context attached</span><span>✓ Exceptions flagged</span></div><span class="flow-status">Ready for approval</span></div>
    <span class="flow-connector" aria-hidden="true">→</span>
    <div class="flow-card"><span class="flow-icon" aria-hidden="true">✓</span><span class="flow-step">03 / ACTION</span><h3>The work moves forward.</h3><div class="fake-lines" aria-hidden="true"><i></i><i></i><i></i></div><span class="flow-status">Job created</span></div>
  </div> : <div class="integration-illustration" role="img" aria-label="A concept integration connecting customer records, inventory, orders, and reporting.">
    <svg viewBox="0 0 900 440" fill="none" aria-hidden="true"><g stroke="#8b9980" stroke-width="1.5"><path d="M200 100H350Q450 100 450 220M700 100H550Q450 100 450 220M200 340H350Q450 340 450 220M700 340H550Q450 340 450 220" stroke-dasharray="5 7"/><circle cx="450" cy="220" r="100" opacity=".25"/><circle cx="450" cy="220" r="145" opacity=".1"/></g></svg>
    <div class="integration-node node-customers"><span aria-hidden="true">◎</span>Customers<small>CRM</small></div><div class="integration-node node-inventory"><span aria-hidden="true">▦</span>Inventory<small>WAREHOUSE</small></div><div class="integration-hub"><span class="hub-mark" aria-hidden="true">Q<span>·</span></span><span>Connected.</span></div><div class="integration-node node-orders"><span aria-hidden="true">↗</span>Orders<small>OPERATIONS</small></div><div class="integration-node node-reporting"><span aria-hidden="true">▥</span>Reporting<small>INSIGHTS</small></div>
  </div>}
  <span class="visual-caption">CONCEPT INTERFACE · FICTIONAL DATA</span>
</div>
<style>
  .service-visual{position:relative;display:grid;place-items:center;height:520px;padding:48px 7%;background:radial-gradient(ellipse at 50% 100%,#d5dbc6,transparent 75%),#e7e5da;overflow:hidden}.interface-preview{width:100%;max-width:850px;transform:perspective(1600px) rotateX(3deg);box-shadow:0 25px 50px #29352e17;border-radius:12px}.visual-caption{position:absolute;bottom:19px;left:24px;color:#6e7768;font:.52rem var(--font-jetbrains-mono),monospace;letter-spacing:.08em}.visual-automation{background:radial-gradient(ellipse at 50% 100%,#dfc9b4,transparent 70%),#e9e1d6}.flow-illustration{display:flex;align-items:center;justify-content:center;gap:18px;width:100%;max-width:960px}.flow-card{display:flex;flex-direction:column;flex:1;min-width:0;min-height:270px;padding:24px;border:1px solid #c3c5b7;background:#f7f3eb;border-radius:14px;box-shadow:0 18px 45px #353b3010}.flow-review{background:#2e3a31;color:#f1e9dd;border-color:#4d5d48;transform:translateY(-18px)}.flow-icon{display:grid;place-items:center;width:35px;height:35px;border-radius:10px;background:#dfe4d4;color:#4d6044;font-size:1.2rem;margin-bottom:25px}.flow-step{font:.5rem var(--font-jetbrains-mono),monospace;letter-spacing:.06em;opacity:.7}.flow-card h3{font-size:1.1rem;line-height:1.3;letter-spacing:-.03em;margin:10px 0 20px;max-width:180px}.flow-connector{color:#8e9a7f;font-size:1.4rem}.fake-lines{display:grid;gap:7px;margin:0 0 23px}.fake-lines i{height:4px;width:100%;background:#dce0d3;border-radius:4px}.fake-lines i:nth-child(2){width:75%}.fake-lines i:nth-child(3){width:45%}.flow-status{font-size:.65rem;color:#6b7a61;margin-top:auto}.flow-review .flow-status{color:#c9d4b7}.review-checks{display:grid;gap:8px;font-size:.65rem;color:#c7d0ba;margin-bottom:24px}.integration-illustration{position:relative;width:100%;max-width:900px;aspect-ratio:900/440}.integration-illustration svg{position:absolute;inset:0;width:100%;height:100%}.integration-node{position:absolute;display:flex;flex-direction:column;align-items:center;justify-content:center;width:160px;height:116px;border:1px solid #c0c6b5;border-radius:14px;background:#f5f1e9;box-shadow:0 12px 24px #2e3a3109;transform:translate(-50%,-50%);font-size:.9rem;font-weight:500}.integration-node>span{font-size:1.5rem;color:#728469;margin-bottom:4px}.integration-node small{font:.45rem var(--font-jetbrains-mono),monospace;color:#6b7764;letter-spacing:.08em;margin-top:7px}.node-customers{left:22%;top:23%}.node-inventory{left:78%;top:23%}.node-orders{left:22%;top:77%}.node-reporting{left:78%;top:77%}.integration-hub{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);display:grid;place-content:center;gap:9px;text-align:center;width:140px;height:140px;border-radius:26px;background:#2c3930;color:#e8ecd9;box-shadow:0 0 45px #a9bc8840;font-size:.8rem}.hub-mark{font-size:2.4rem;line-height:1;font-weight:500}.hub-mark span{color:#c19a76}
  @media(max-width:850px){.service-visual{height:440px;padding:36px 5%}.flow-illustration{gap:10px}.flow-card{padding:18px;min-height:255px}.flow-card h3{font-size:.95rem}.integration-node{width:135px;height:105px}.integration-hub{width:115px;height:115px}}
  @media(max-width:600px){.service-visual{height:390px;padding:32px 18px 42px}.interface-preview{max-width:400px;transform:none}.flow-illustration{gap:8px;align-items:stretch}.flow-card{padding:16px 11px;min-height:235px;border-radius:10px}.flow-icon{width:28px;height:28px;margin-bottom:22px;font-size:1rem}.flow-card h3{font-size:.8rem}.flow-step{font-size:.39rem}.flow-connector{display:none}.flow-review{transform:translateY(-12px)}.flow-status,.review-checks{font-size:.5rem}.integration-illustration{aspect-ratio:1}.integration-node{width:100px;height:92px;font-size:.75rem}.integration-node small{font-size:.39rem}.integration-hub{width:90px;height:90px;border-radius:20px;font-size:.65rem}.hub-mark{font-size:1.9rem}.node-customers,.node-orders{left:19%}.node-inventory,.node-reporting{left:81%}.node-customers,.node-inventory{top:17%}.node-orders,.node-reporting{top:83%}.visual-caption{font-size:.43rem;left:18px;bottom:14px}}

  .mock-topbar{display:flex;align-items:center;gap:12px;padding:14px 24px;background:#263229;border-bottom:1px solid #5b6c4d66;color:#c5cfb6;font:.56rem var(--font-jetbrains-mono),monospace;letter-spacing:.08em}.mock-brand{font:500 1.3rem var(--font-inter),sans-serif;letter-spacing:-.08em;color:#f1e9dd}.mock-brand>span{color:#d8b895}.mock-connected{margin-left:auto;color:#aebf99;letter-spacing:0;font-size:.5rem}.mock-content{padding:30px 34px 25px;background:#303d32;color:#ececde}.mock-kicker{font:.48rem var(--font-jetbrains-mono),monospace;color:#aab99b;letter-spacing:.1em;margin-bottom:9px}.mock-content>h3{font-size:clamp(1.25rem,2.5vw,2rem);line-height:1.2;margin-bottom:25px}.mock-metrics{display:grid;grid-template-columns:repeat(3,1fr);padding-bottom:23px;border-bottom:1px solid #61715166;margin-bottom:7px}.mock-metrics>div{border-left:1px solid #65775466;padding-left:26px}.mock-metrics>div:first-child{padding:0;border:0}.mock-metrics strong{display:block;font-size:2rem;line-height:1.2;font-weight:400;letter-spacing:-.05em}.mock-metrics>div:last-child strong{color:#dfb28c}.mock-metrics>div>span{font-size:.6rem;color:#b1bea0}.mock-queue{font-size:.68rem;color:#c8d2b8}.mock-queue>div{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:10px 0;border-bottom:1px solid #62715444}.mock-queue>div:last-child{border:0}.mock-queue>div>span:first-child{display:flex;align-items:center;gap:9px;color:#e1e5d5}.mock-queue i{width:5px;height:5px;border-radius:50%;background:#a6bd8c}.mock-queue>div>span:last-child{font-size:.57rem;color:#b0c299}.mock-equipment{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.mock-equipment>div{min-width:0;background:#384634;border:1px solid #63765288;border-radius:9px;padding:20px}.equipment-online{font:.44rem var(--font-jetbrains-mono),monospace;color:#b8cca0}.mock-equipment h4{font-size:.8rem;letter-spacing:0;margin:16px 0 8px}.mock-equipment p{font-size:clamp(1rem,2.5vw,1.9rem);letter-spacing:-.04em;white-space:nowrap}.mock-equipment small{font-size:.55rem;letter-spacing:0;margin-left:5px;color:#b8c5a8}.mock-equipment svg{display:block;width:100%;margin-top:20px}.interface-preview{overflow:hidden}
  @media(max-width:600px){.mock-topbar{padding:12px 15px;gap:8px;font-size:.46rem}.mock-connected{font-size:.42rem}.mock-content{padding:22px 17px 15px}.mock-kicker{font-size:.4rem}.mock-content>h3{font-size:1.25rem;margin-bottom:23px}.mock-metrics{padding-bottom:15px}.mock-metrics strong{font-size:1.55rem}.mock-metrics>div{padding-left:17px}.mock-metrics>div>span{font-size:.49rem}.mock-queue{font-size:.54rem}.mock-queue>div{padding:10px 0}.mock-queue>div>span:last-child{font-size:.45rem}.mock-equipment{gap:6px}.mock-equipment>div{padding:12px 7px;border-radius:6px}.equipment-online{font-size:.34rem}.mock-equipment h4{font-size:.57rem;letter-spacing:-.015em;margin:19px 0 8px}.mock-equipment p{font-size:1rem}.mock-equipment small{font-size:.4rem;display:block;margin:3px 0 0}.mock-equipment svg{margin-top:26px}.mock-equipment{padding-bottom:8px}}
</style>
