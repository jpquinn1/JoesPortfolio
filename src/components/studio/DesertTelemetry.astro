---
const channels = [
  {id:'weather',label:'Weather',value:'94.2',unit:'°F'},
  {id:'ballistics',label:'Shot',value:'268',unit:'m/s'},
  {id:'freight',label:'Freight',value:'840',unit:'lb'},
  {id:'workshop',label:'Repair',value:'68',unit:'%'},
];
---
<div class="desert-feed" aria-label="Fictional desert telemetry">
  <span class="feed-label"><i aria-hidden="true"></i> SIMULATED SIGNALS</span>
  <div class="feed-readings" role="group" aria-label="Choose a desert signal">
    {channels.map(channel => <button type="button" data-desert-channel={channel.id} aria-pressed={channel.id === 'weather' ? 'true' : 'false'} disabled><span>{channel.label}</span><strong><span data-reading={channel.id}>{channel.value}</span><small>{channel.unit}</small></strong></button>)}
    <button type="button" class="feed-pause" data-motion-toggle aria-label="Pause desert animation" aria-pressed="false" hidden><span data-motion-icon aria-hidden="true">Ⅱ</span></button>
  </div>
  <p class="feed-detail"><span data-signal-detail>Wind 7.4 mph · Humidity 18%</span></p>
  <p class="feed-announcement" data-desert-announcement aria-live="polite"></p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-desert-experience]').forEach(root => {
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-desert-channel]')];
    const pauseButton = root.querySelector<HTMLButtonElement>('[data-motion-toggle]')!;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = preference.matches;
    let visible = true;
    let tick = 0;
    let shots = 1;
    let channel = 'weather';
    let timer: ReturnType<typeof setInterval> | undefined;
    const set = (selector: string,value: string) => { const node = root.querySelector(selector); if (node) node.textContent = value; };
    const update = () => {
      const barrels = (7 + Math.floor(tick / 3)) % 13;
      const repair = 68 + Math.floor(tick / 3) % 33;
      set('[data-reading="weather"]',(94.2 + Math.sin(tick / 5) * 1.6).toFixed(1));
      set('[data-reading="ballistics"]',String(260 + (shots * 7 + 1) % 19));
      set('[data-reading="freight"]',(barrels * 120).toLocaleString('en-US'));
      set('[data-reading="workshop"]',String(repair));
      const details: Record<string,string> = {
        weather: `Wind ${(7.4 + Math.sin(tick / 3) * 2.1).toFixed(1)} mph · Humidity 18%`,
        ballistics: `Shot ${String(shots).padStart(3,'0')} · Flight 0.42 s`,
        freight: `${barrels}/12 barrels · ${barrels === 12 ? 'Ready to dispatch' : 'Loading wagon'}`,
        workshop: `Parts ${repair >= 85 ? 4 : 3}/4 · Labor ${(2.4 + (repair - 68) / 20).toFixed(1)} h`,
      };
      set('[data-signal-detail]',details[channel]);
    };
    const sync = () => {
      if (timer) clearInterval(timer);
      timer = undefined;
      const running = !paused && visible && !document.hidden;
      root.dataset.motion = running ? 'running' : 'paused';
      pauseButton.setAttribute('aria-pressed',String(paused));
      pauseButton.setAttribute('aria-label',paused ? 'Resume desert animation' : 'Pause desert animation');
      set('[data-motion-icon]',paused ? '▷' : 'Ⅱ');
      if (running) timer = setInterval(() => { tick++; root.dataset.shot = String(tick % 8 === 0); if (tick % 8 === 0) shots++; update(); },1800);
    };
    buttons.forEach(button => {
      button.disabled = false;
      button.addEventListener('click',() => {
        channel = button.dataset.desertChannel!;
        root.dataset.activeChannel = channel;
        buttons.forEach(other => other.setAttribute('aria-pressed',String(other === button)));
        if (channel === 'ballistics') { shots++; if (!paused) root.dataset.shot = 'true'; }
        update();
        set('[data-desert-announcement]',`${button.querySelector('span')?.textContent} signal selected. All readings are simulated.`);
      });
    });
    pauseButton.hidden = false;
    pauseButton.addEventListener('click',() => { paused = !paused; root.dataset.shot = 'false'; sync(); });
    preference.addEventListener('change',event => { paused = event.matches; sync(); });
    document.addEventListener('visibilitychange',sync);
    new IntersectionObserver(entries => { visible = entries.some(entry => entry.isIntersecting); sync(); },{rootMargin:'-85px 0px 0px 0px'}).observe(root);
    addEventListener('pagehide',() => { if (timer) clearInterval(timer); });
    addEventListener('pageshow',sync);
    sync();
  });
</script>
<style>
  [hidden]{display:none!important}.desert-feed{width:fit-content;max-width:100%;text-align:left}.feed-label{display:flex;align-items:center;gap:7px;font:.46rem var(--font-jetbrains-mono),monospace;letter-spacing:.1em;color:#747d6b}.feed-label i{width:4px;height:4px;border-radius:50%;background:#839672;box-shadow:0 0 6px #aab895}.feed-readings{display:flex;align-items:center;gap:18px;margin-top:5px}.feed-readings button{display:grid;gap:3px;min-height:44px;padding:3px 0;border:0;background:none;color:#737c6a;font:.51rem var(--font-jetbrains-mono),monospace;text-align:left}.feed-readings button[aria-pressed="true"]{color:#984725}.feed-readings strong{font-weight:400;font-size:.65rem;font-variant-numeric:tabular-nums;color:#4c5c43}.feed-readings small{margin-left:4px;font-size:.48rem;color:#79836f}.feed-readings .feed-pause{display:grid;place-items:center;width:44px;height:44px;font-size:.75rem;min-width:44px;color:#737c6a}.feed-detail{font:.48rem var(--font-jetbrains-mono),monospace;color:#79836f;margin-top:4px;min-height:1.5em}.feed-announcement{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;white-space:nowrap}
  @media(max-width:400px){.feed-readings{gap:14px}.feed-readings button{font-size:.47rem}.feed-readings strong{font-size:.61rem}}
</style>
