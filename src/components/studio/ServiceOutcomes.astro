---
import Icon from './WorkflowIcon.astro';
import { studioHref } from '../../lib/studio-urls';
const services = [
  { id: 'intake', number: '01', title: 'Enter it once.', description: 'Turn a request into an assigned job. Keep the details moving between your tools.', examples: 'Requests · Job tracking · Approvals', href: '/studio/work/operations-automation', link: 'Explore automation' },
  { id: 'clients', number: '02', title: 'Keep customers in the loop.', description: 'Connect quotes, reminders, and updates. Spend less time chasing the next reply.', examples: 'Quotes · Reminders · Client portals', href: '#contact', link: 'Discuss your workflow' },
  { id: 'telemetry', number: '03', title: 'Catch the exception.', description: 'See equipment issues in one place. Route the next check to the right person.', examples: 'Equipment · Alerts · Dashboards', href: '/studio/work/connected-equipment', link: 'Explore connected systems' },
];
---
<div class="outcome-grid">
  {services.map(service => <article class={`outcome-card outcome-${service.id}`}>
    <div class="outcome-visual" aria-hidden="true">
      {service.id === 'intake' && <div class="intake-graphic"><div class="intake-document"><span class="graphic-icon"><Icon name="form" size={20} /></span><strong>Service request</strong><div class="form-line"></div><div class="form-line short"></div><span class="form-submit">Submit request <Icon name="arrow" size={13} /></span></div><span class="graphic-connector"></span><div class="assigned-job"><span class="check-dot"><Icon name="check" size={13} /></span><div><strong>Job created</strong><span>Details captured · Owner assigned</span></div></div></div>}
      {service.id === 'clients' && <div class="client-graphic"><div class="client-top"><span class="client-avatar">N</span><div><strong>Welcome, Northside.</strong><span>Here’s what happens next.</span></div></div><div class="client-progress"><span class="complete"><Icon name="check" size={13} /></span><i></i><span class="complete"><Icon name="check" size={13} /></span><i></i><span>3</span></div><div class="client-steps"><span>Request</span><span>Proposal</span><span>In progress</span></div><div class="client-update"><Icon name="mail" size={16} /><span>Your proposal is ready to review.</span><span class="update-dot"></span></div></div>}
      {service.id === 'telemetry' && <div class="telemetry-graphic"><div class="telemetry-top"><span><Icon name="signal" size={16} />Equipment health</span><span class="sample-label">Sample</span></div><div class="telemetry-reading"><strong>26.4<small>°C</small></strong><span>Workshop temperature</span></div><svg class="telemetry-chart" viewBox="0 0 280 64" fill="none"><path d="M0 55H280M0 31H280M0 7H280" stroke="var(--studio-border)" stroke-width=".7"/><path d="M0 23H280" stroke="var(--studio-warning)" stroke-dasharray="4 5"/><path d="M0 52 15 50 30 53 45 47 60 48 75 42 90 46 105 36 120 39 135 32 150 36 165 28 180 29 195 18 210 23 225 14 240 16 255 9 270 12 280 6" stroke="var(--studio-accent)" stroke-width="2.5"/><circle class="signal-pulse" cx="270" cy="12" r="4" fill="var(--studio-accent)"/></svg><div class="telemetry-alert"><span></span>Threshold crossed <Icon name="arrow" size={13} /> Team notified</div></div>}
    </div>
    <div class="outcome-copy"><p class="outcome-number">{service.number} / {service.id === 'intake' ? 'Operations' : service.id === 'clients' ? 'Client systems' : 'Connected equipment'}</p><h3>{service.title}</h3><p>{service.description}</p><p class="outcome-examples">{service.examples}</p><a href={service.href.startsWith('#') ? service.href : studioHref(service.href)}>{service.link}<span aria-hidden="true">↗</span></a></div>
  </article>)}
</div>
<style>
  .outcome-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 22px; }
  .outcome-card { border: 1px solid var(--studio-border); border-radius: 12px; overflow: hidden; background: var(--studio-surface); display: flex; flex-direction: column; }
  .outcome-visual { height: 242px; padding: 27px; display: grid; place-items: center; border-bottom: 1px solid var(--studio-border); background-color: var(--studio-raised); background-image: radial-gradient(#5eead412 .7px,transparent .7px); background-size: 15px 15px; }
  .outcome-clients .outcome-visual { background-color: var(--studio-raised); }.outcome-telemetry .outcome-visual { background-color: var(--studio-raised); }
  .intake-graphic { width: 100%; max-width: 250px; display: flex; flex-direction: column; align-items: center; }
  .intake-document { background: var(--studio-surface); border: 1px solid var(--studio-border); border-radius: 8px; padding: 15px; width: 83%; box-shadow: 0 7px 18px var(--studio-shadow); }
  .graphic-icon { color: var(--studio-accent); display: inline-flex; vertical-align: middle; }.intake-document>strong { font-size: .66rem; font-weight: 500; margin-left: 5px; }
  .form-line { background: var(--studio-raised); height: 7px; border-radius: 3px; margin-top: 14px; width: 94%; }.form-line.short { width: 68%; margin-top: 7px; }
  .form-submit { display: flex; justify-content: space-between; align-items: center; margin-top: 15px; padding: 7px 9px; background: var(--studio-accent-soft); color: var(--studio-accent); font-size: .56rem; border-radius: 4px; }
  .graphic-connector { height: 20px; border-left: 1px dashed var(--studio-accent-line); }
  .assigned-job { display: flex; align-items: center; gap: 9px; padding: 12px; border-radius: 7px; background: var(--studio-surface); border: 1px solid var(--studio-accent-line); width: 100%; }.assigned-job strong,.assigned-job div>span { display: block; }.assigned-job strong { font-size: .65rem; font-weight: 500; }.assigned-job div>span { font-size: .5rem; color: var(--studio-muted); margin-top: 3px; }
  .check-dot { display: grid; place-items: center; width: 24px; height: 24px; background: var(--studio-accent-soft); color: var(--studio-accent); border-radius: 50%; flex: none; }
  .client-graphic { width: 100%; padding: 20px 16px 16px; border: 1px solid var(--studio-border); background: var(--studio-surface); border-radius: 9px; box-shadow: 0 10px 24px var(--studio-shadow); }
  .client-top { display: flex; align-items: center; gap: 10px; }.client-avatar { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--studio-raised); color: var(--studio-accent); font-size: .7rem; }.client-top strong { display: block; font-size: .69rem; font-weight: 600; }.client-top div>span { display: block; font-size: .52rem; color: var(--studio-muted); margin-top: 3px; }
  .client-progress { display: flex; align-items: center; margin: 22px 13px 7px; }.client-progress>span { display: grid; place-items: center; width: 24px; height: 24px; flex: none; border-radius: 50%; border: 1px solid var(--studio-border); font-size: .55rem; color: var(--studio-muted); }.client-progress .complete { background: var(--studio-accent-soft); border-color: var(--studio-accent-soft); color: var(--studio-accent); }.client-progress i { height: 1px; background: var(--studio-accent-line); flex: 1; }
  .client-steps { display: flex; justify-content: space-between; font-size: .5rem; color: var(--studio-muted); }.client-update { display: flex; align-items: center; gap: 8px; margin-top: 20px; border-top: 1px solid var(--studio-border); padding-top: 13px; color: var(--studio-muted); font-size: .5rem; }.update-dot { width: 5px; height: 5px; margin-left: auto; border-radius: 50%; background: var(--studio-warning); flex: none; }
  .telemetry-graphic { border: 1px solid var(--studio-accent-line); background: var(--studio-surface); padding: 17px; border-radius: 9px; width: 100%; }.telemetry-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }.telemetry-top>span:first-child { display: flex; align-items: center; gap: 7px; font-size: .64rem; }.sample-label { font: .46rem var(--font-jetbrains-mono),monospace; color: var(--studio-muted); text-transform: uppercase; }.telemetry-reading { display: flex; align-items: center; gap: 15px; margin-top: 14px; }.telemetry-reading strong { font: 500 1.7rem var(--font-jetbrains-mono),monospace; color: var(--studio-accent); }.telemetry-reading small { font-size: .8rem; margin-left: 3px; }.telemetry-reading>span { font-size: .5rem; max-width: 60px; color: var(--studio-muted); }.telemetry-chart { width: 100%; height: 64px; margin: 5px 0; }.signal-pulse { animation: signal 3s ease-in-out infinite; }.telemetry-alert { display: flex; align-items: center; gap: 6px; font-size: .5rem; color: var(--studio-warning); }.telemetry-alert>span { height: 5px; width: 5px; background: var(--studio-warning); border-radius: 50%; }
  .outcome-copy { padding: 28px 26px 22px; display: flex; flex-direction: column; flex: 1; }.outcome-number { color: var(--studio-muted); font: .57rem/1.6 var(--font-jetbrains-mono),monospace; letter-spacing: .02em; text-transform: uppercase; }.outcome-copy h3 { font-size: 1.35rem; font-weight: 600; letter-spacing: -.04em; line-height: 1.2; margin: 14px 0 13px; max-width: 250px; }.outcome-copy>p:not(.outcome-number):not(.outcome-examples) { color: var(--studio-muted); font-size: 1rem; line-height: 1.7; }.outcome-examples { color: var(--studio-muted); font-size: .61rem; padding-top: 21px; margin-top: auto; }.outcome-copy a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; font-size: .84rem; font-weight: 500; margin-top: 14px; border-top: 1px solid var(--studio-border); padding-top: 12px; }.outcome-copy a:hover { color: var(--studio-accent); }
  @keyframes signal { 0%,100% { opacity: 1; } 50% { opacity: .25; } }
  @media(min-width:1001px) { .outcome-copy h3 { min-height: 2.4em; } }
  @media(max-width:1050px) and (min-width:761px) { .outcome-grid { gap: 14px; }.outcome-visual { padding: 18px; height: 225px; }.outcome-copy { padding: 23px 18px 18px; }.outcome-copy h3 { font-size: 1.2rem; }.client-update { font-size: .46rem; }.telemetry-alert { font-size: .44rem; gap: 4px; }.telemetry-reading { gap: 9px; }.telemetry-reading strong { font-size: 1.4rem; } }
  @media(max-width:1000px) { .outcome-grid { grid-template-columns: 1fr; gap: 22px; }.outcome-card { display: grid; grid-template-columns: .9fr 1fr; }.outcome-visual { height: 100%; min-height: 260px; padding: 28px; border-bottom: 0; border-right: 1px solid var(--studio-border); }.outcome-copy { padding: 26px 22px; }.outcome-copy h3 { font-size: 1.3rem; }.outcome-examples { font-size: .65rem; line-height: 1.7; }.client-graphic,.telemetry-graphic { max-width: 290px; } }
  @media(max-width:540px) { .outcome-card { display: flex; }.outcome-visual { height: 236px; min-height: 0; border-right: 0; border-bottom: 1px solid var(--studio-border); padding: 28px 35px; }.client-graphic,.telemetry-graphic { max-width: 290px; }.outcome-copy { padding: 24px; }.outcome-copy h3 { font-size: 1.4rem; max-width: none; }.outcome-copy>p:not(.outcome-number):not(.outcome-examples) { font-size: 1rem; }.outcome-copy a { font-size: .84rem; }.outcome-examples { font-size: .67rem; } }
</style>
