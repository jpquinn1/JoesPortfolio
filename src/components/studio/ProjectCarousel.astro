---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import TechStack from '../TechStack.astro';
import ProjectVideo from '../ProjectVideo.astro';
const projects = (await getCollection('projects', ({ data }) => data.featured && data.category === 'professional')).sort((a, b) => a.data.order - b.data.order);
const total = String(projects.length).padStart(2, '0');
---
<div class="project-carousel" data-project-carousel role="region" aria-roledescription="carousel" aria-label="Selected professional projects">
  <div class="project-rail" data-project-rail tabindex="0" aria-label="Scroll through projects. Use left and right arrow keys." role="list">
    {projects.map((project,index) => <article class="project-slide" data-project-slide role="listitem" aria-label={`${index + 1} of ${projects.length}: ${project.data.title}`}>
      <header class="project-slide-heading"><p>{project.data.role} · {project.data.status}</p><h3 id={`project-${project.id}`}>{project.data.title}</h3><div class="project-slide-summary">{project.data.description}</div></header>
      {project.data.cardVideo ? <div class="project-visual"><ProjectVideo title={project.data.title} video={project.data.cardVideo} /></div> : <a class="project-visual" href={`/projects/${project.id}`} aria-label={`Explore ${project.data.title}`}><Image class="project-capture" src={project.data.screenshot} alt={project.data.screenshotAlt ?? `${project.data.title} preview`} widths={[640, 1024, 1600]} sizes="(max-width: 760px) 80vw, 900px" loading="lazy" /></a>}
      <div class="project-tools"><TechStack tools={project.data.tools.slice(0,4)} compact /></div>
      <footer class="project-slide-footer"><span>{String(index + 1).padStart(2, '0')} / {total}</span><a href={`/projects/${project.id}`} aria-label={`Read about ${project.data.title}`}>Explore the project <span aria-hidden="true">↗</span></a></footer>
    </article>)}
  </div>
  <div class="carousel-controls" hidden>
    <button class="carousel-arrow" type="button" data-project-prev aria-label="Previous project" disabled>←</button>
    <div class="project-dots" role="group" aria-label="Choose a project">{projects.map((project,index) => <button type="button" data-project-index={index} aria-label={`Show ${project.data.title}`} aria-current={index === 0 ? 'true' : undefined}><span></span></button>)}</div>
    <button class="carousel-arrow" type="button" data-project-next aria-label="Next project">→</button>
  </div>
  <p class="carousel-announcement" aria-live="polite" data-project-announcement></p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-project-carousel]').forEach(root => {
    const rail = root.querySelector<HTMLElement>('[data-project-rail]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-project-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-project-index]')];
    const previous = root.querySelector<HTMLButtonElement>('[data-project-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-project-next]')!;
    const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (slides.length === 0) return;
    let current = 0;
    let frame = 0;
    const reflect = (index: number) => {
      current = index;
      dots.forEach((dot,i) => i === index ? dot.setAttribute('aria-current','true') : dot.removeAttribute('aria-current'));
      previous.disabled = index === 0;
      next.disabled = index === slides.length - 1;
    };
    const select = (index: number) => {
      const target = Math.max(0,Math.min(index,slides.length - 1));
      const box = slides[target].getBoundingClientRect();
      const parent = rail.getBoundingClientRect();
      rail.scrollTo({ left: rail.scrollLeft + box.left - parent.left - (rail.clientWidth - box.width) / 2, behavior: preference.matches ? 'instant' : 'smooth' });
      reflect(target);
      root.querySelector('[data-project-announcement]')!.textContent = slides[target].getAttribute('aria-label');
    };
    const updateFromScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const parent = rail.getBoundingClientRect();
        const center = parent.left + parent.width / 2;
        const distances = slides.map(slide => { const rect = slide.getBoundingClientRect(); return Math.abs(rect.left + rect.width / 2 - center); });
        reflect(distances.indexOf(Math.min(...distances)));
      });
    };
    rail.addEventListener('scroll',updateFromScroll,{passive:true});
    rail.addEventListener('keydown',event => {
      if (event.target !== rail) return;
      if (event.key === 'ArrowRight') { event.preventDefault(); select(current + 1); }
      else if (event.key === 'ArrowLeft') { event.preventDefault(); select(current - 1); }
      else if (event.key === 'Home') { event.preventDefault(); select(0); }
      else if (event.key === 'End') { event.preventDefault(); select(slides.length - 1); }
    });
    previous.addEventListener('click',() => select(current - 1));
    next.addEventListener('click',() => select(current + 1));
    dots.forEach((dot,index) => dot.addEventListener('click',() => select(index)));
    new ResizeObserver(updateFromScroll).observe(rail);
    root.querySelector<HTMLElement>('.carousel-controls')!.hidden = false;
    reflect(0);
  });
</script>
<style>
  [hidden]{display:none!important}.project-carousel{--slide-width:min(82vw,1040px)}.project-rail{display:flex;gap:24px;overflow-x:auto;scroll-snap-type:x mandatory;overscroll-behavior-x:contain;padding:10px calc((100% - var(--slide-width))/2) 28px;scroll-padding-inline:calc((100% - var(--slide-width))/2);scrollbar-width:none}.project-rail::-webkit-scrollbar{display:none}.project-rail:focus-visible{outline-offset:-5px}.project-slide{flex:0 0 var(--slide-width);min-width:0;scroll-snap-align:center;border-radius:24px;background:#f8f3eb;border:1px solid #75827c20;overflow:hidden;display:flex;flex-direction:column}.project-slide-heading{text-align:center;padding:37px 36px 10px;max-width:600px;margin:0 auto}.project-slide-heading>p{font:.59rem var(--font-jetbrains-mono),monospace;text-transform:uppercase;letter-spacing:.11em;color:#758068;margin-bottom:15px}.project-slide-heading h3{font-size:clamp(1.45rem,2.5vw,2.15rem);line-height:1.18;letter-spacing:-.045em;max-width:540px;margin:auto}.project-visual{min-height:390px;display:grid;align-items:center;justify-items:center;padding:28px 7%;flex:1;background:radial-gradient(ellipse at 50% 100%,#d9dfca44,transparent 70%)}.project-interface{width:100%;max-width:840px;box-shadow:0 20px 35px #27342c1c;border-radius:13px;overflow:hidden}.project-interface :global(.demo-figure){pointer-events:none}.project-visual :global(>.showcase-asset){max-height:520px;border-radius:12px}.project-slide-footer{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:12px 35px 25px}.project-slide-footer>span{font:.6rem var(--font-jetbrains-mono),monospace;color:#818678}.project-slide-footer a{display:flex;align-items:center;gap:30px;min-height:44px;font-size:.77rem;color:#5c6d54}.project-slide-footer a:hover{color:#984725}.carousel-controls{display:flex;align-items:center;justify-content:center;gap:18px;margin-top:8px}.carousel-arrow{display:grid;place-items:center;width:46px;height:46px;border:0;border-radius:50%;background:#dfdfd2;color:#45523f;font-size:1.1rem}.carousel-arrow:hover:not(:disabled){background:#d0d6c2}.carousel-arrow:disabled{opacity:.35;cursor:default}.project-dots{display:flex;align-items:center;gap:2px;padding:0 12px;border-radius:28px;background:#dfdfd2;height:46px}.project-dots button{height:44px;width:31px;display:grid;place-items:center;background:transparent;border:0;padding:0}.project-dots span{width:6px;height:6px;background:#8c9680;border-radius:6px;transition:width .2s,background .2s}.project-dots [aria-current="true"] span{width:23px;background:#354432}.carousel-announcement{position:absolute;width:1px;height:1px;clip-path:inset(50%);overflow:hidden;white-space:nowrap}
  @media(max-width:760px){.project-carousel{--slide-width:88vw}.project-rail{gap:14px;padding-bottom:20px}.project-slide{border-radius:18px}.project-slide-heading{padding:28px 24px 8px}.project-slide-heading>p{font-size:.51rem}.project-slide-heading h3{font-size:1.5rem}.project-visual{min-height:320px;padding:20px 5%}.project-slide-footer{padding:5px 20px 18px}.project-slide-footer a{font-size:.7rem;gap:15px}.carousel-controls{gap:12px}.project-dots{height:44px}.carousel-arrow{width:44px;height:44px}}
  @media(prefers-reduced-motion:reduce){.project-dots span{transition:none}}
  .project-poster{width:100%}
  .project-poster :global(.service-visual){height:420px;padding:0;background:none}
  .project-poster :global(.visual-caption){display:none}
  .project-interface :global(.demo-heading),.project-interface :global(.demo-footer),.project-interface :global(.spatial-sidebar){display:none}
  .project-interface :global(.spatial-workspace){grid-template-columns:1fr}
  .project-interface :global(.spatial-canvas svg){height:210px}
  @media(min-width:761px){.project-poster :global(.mock-equipment svg){height:55px;margin-top:12px}}
  @media(max-width:760px){.project-poster :global(.service-visual){height:340px;padding:5px 0 15px}.project-poster :global(.interface-preview){width:100%}.project-interface :global(.spatial-canvas svg){height:180px}}
  .project-slide-summary{margin:14px auto 0;max-width:560px;font-size:.87rem;line-height:1.65;color:#68715f}
  .project-visual{min-height:0;text-decoration:none}
  .project-capture{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:contain;border:1px solid #7d887547;border-radius:12px;background:#edf0eb}
  .project-tools{padding:0 7% 20px;color:#5c6d54}
  .project-visual :global(.project-video){border:1px solid #7d887547;border-radius:12px}
  .project-tools :global(.tech-stack){justify-content:center}
  @media(max-width:760px){.project-slide-summary{font-size:.78rem}.project-visual{min-height:0;padding:20px 5% 18px}.project-capture{border-radius:8px}.project-tools{padding:0 6% 15px}.project-tools :global(.tech-stack){gap:.4rem .7rem}.project-tools :global(.tech-stack li){font-size:.64rem}}
</style>
