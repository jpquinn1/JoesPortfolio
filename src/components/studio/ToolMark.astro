---
import Icon from './WorkflowIcon.astro';
import { studioTools, type StudioTool } from '../../data/studio-tools';

interface Props { tool: StudioTool; size?: number; loading?: 'eager' | 'lazy'; }
const { tool, size = 24, loading = 'lazy' } = Astro.props;
const item = studioTools[tool];
---
<span class="tool-mark" style={`--mark-size:${size}px;color:${item.color}`} aria-hidden="true">
  {item.logo ? <img src={`/images/tools/${item.logo}.svg`} width={size} height={size} alt="" loading={loading} /> : <Icon name="sheet" size={size} />}
</span>
<style>
  .tool-mark { display: inline-grid; place-items: center; flex: none; width: var(--mark-size); height: var(--mark-size); }
  img { display: block; width: 100%; height: 100%; object-fit: contain; }
</style>
