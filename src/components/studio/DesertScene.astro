<style>
  .desert-background{position:absolute;inset:0;z-index:-1;pointer-events:none}.desert-pin{position:sticky;top:85px;height:calc(100svh - 85px);min-height:350px}.desert-vignette{position:absolute;right:3vw;bottom:6vh;width:min(39vw,500px);opacity:.37;mix-blend-mode:multiply}.desert-vignette img{display:block;width:100%;height:auto;mask-image:radial-gradient(ellipse at 50% 50%,#000 42%,transparent 74%)}svg{position:absolute;inset:0;width:100%;height:100%}.weather-signal{transform-origin:94px 240px;animation:orbit 40s linear infinite;opacity:.45}.shot-trace,.freight-signal,.workshop-signal{opacity:0}.freight-signal{animation:freight 12s linear infinite}:global([data-shot="true"]) .shot-trace{animation:shot 1.4s ease-out both}:global([data-active-channel="freight"]) .freight-signal,:global([data-active-channel="workshop"]) .workshop-signal{opacity:.7}:global([data-motion="paused"]) svg *{animation-play-state:paused!important}
