<script>
  const scene = document.querySelector<HTMLElement>('[data-desert-scene]');
  if (scene) {
    const button = document.querySelector<HTMLButtonElement>('[data-desert-toggle]')!;
    const elevation = document.querySelector<HTMLElement>('[data-sun-elevation]')!;
    const packets = document.querySelector<HTMLElement>('[data-desert-packets]')!;
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = preference.matches;
    let progress = 0;
    let scrollRange = 1;
    let sceneHeight = innerHeight;
    let frame = 0;
    let packetCount = 128;
    let timer: ReturnType<typeof setInterval> | undefined;
    const paintSun = () => {
      scene.style.setProperty('--sun-y', `${progress * sceneHeight * .62}px`);
      scene.style.setProperty('--sun-x', `${progress * -24}px`);
      scene.style.setProperty('--sun-hue', String(39 - progress * 20));
      elevation.textContent = `${Math.round(64 - progress * 68)}°`;
    };
    const update = () => {
      frame = 0;
      if (paused || preference.matches || document.hidden) return;
      progress = Math.min(1, Math.max(0, scrollY / scrollRange));
      paintSun();
    };
    const schedule = () => { if (!frame && !paused && !preference.matches && !document.hidden) frame = requestAnimationFrame(update); };
    const measure = () => {
      scrollRange = Math.max(1, document.documentElement.scrollHeight - innerHeight);
      sceneHeight = scene.clientHeight;
      paintSun();
      schedule();
    };
    const sync = () => {
      clearInterval(timer);
      cancelAnimationFrame(frame);
      frame = 0;
      const running = !paused && !preference.matches && !document.hidden;
      scene.dataset.running = String(running);
      document.body.dataset.ambientMotion = running ? 'on' : 'off';
      button.disabled = preference.matches;
      button.textContent = preference.matches ? 'Reduced motion' : paused ? 'Play scene' : 'Pause scene';
      if (running) {
        schedule();
        timer = setInterval(() => { packetCount += 3; packets.textContent = String(packetCount); }, 4200);
      }
    };
    button.hidden = false;
    button.addEventListener('click', () => { paused = !paused; sync(); });
    preference.addEventListener('change', () => { paused = preference.matches; sync(); });
    document.addEventListener('visibilitychange', sync);
    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', measure, { passive: true });
    new ResizeObserver(measure).observe(document.body);
    addEventListener('pagehide', () => { clearInterval(timer); cancelAnimationFrame(frame); frame = 0; scene.dataset.running = 'false'; document.body.dataset.ambientMotion = 'off'; });
    addEventListener('pageshow', () => { measure(); sync(); });
    const reveal = new IntersectionObserver(entries => {
      for (const entry of entries) if (entry.isIntersecting) {
        if (!paused && !preference.matches) entry.target.classList.add('is-revealed');
        reveal.unobserve(entry.target);
      }
    }, { threshold: .12 });
    document.querySelectorAll('.outcome-card, .approach-steps li, .founder-grid').forEach(element => { element.setAttribute('data-reveal', ''); reveal.observe(element); });
    measure();
    sync();
  }
</script>

<style>
  .desert-environment { position: fixed; inset: 0; height: 100vh; height: 100svh; z-index: -1; pointer-events: none; overflow: hidden; --sun-y: 0px; --sun-x: 0px; --sun-hue: 39; }
  .sun-track { position: absolute; inset: 0; mask-image: linear-gradient(#000 0 59%,transparent 77%); }
  .desert-sun { position: absolute; top: 14%; right: 5.5%; width: clamp(80px,8vw,128px); aspect-ratio: 1; border-radius: 50%; background: hsl(var(--sun-hue) 70% 69% / .38); box-shadow: 0 0 65px 28px hsl(var(--sun-hue) 70% 65% / .065); transform: translate3d(var(--sun-x),var(--sun-y),0); transition: transform .16s linear,background .2s; }
  .desert-landscape { position: absolute; inset: 0; width: 100%; height: 100%; }
  .landscape-narrow { display: none; }
  .distant-ridge { fill: #dcc5a52e; stroke: #9c866b38; stroke-width: 1.2; stroke-linejoin: round; }
  .ridge-fold { stroke: #9c866b24; stroke-width: 1; stroke-linejoin: round; }
  .near-ridge { fill: #d3b59312; stroke: #a7917625; stroke-width: 1; }
  .terrain-contour { stroke: #a7917625; stroke-width: 1; }
  .desert-cactus { fill: #8a9e892a; stroke: #74897070; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .cactus-rib { fill: none; stroke: #74897045; stroke-width: 1; }
  .sensor-route { stroke: #23685d26; stroke-width: 1; stroke-dasharray: 3 7; }
  .sensor-packet { stroke: #23685d80; stroke-width: 2; stroke-dasharray: 9 991; animation: desert-packet 13s linear infinite; }
  .sensor-node { fill: #23685d75; }.sensor-ring { fill: none; stroke: #23685d70; stroke-width: 1; transform-origin: 0 0; animation: desert-signal 4.2s ease-out infinite; }
  [data-running="false"] :is(.sensor-packet,.sensor-ring) { animation-play-state: paused; }
  @keyframes desert-packet { to { stroke-dashoffset: -1000; } }
  @keyframes desert-signal { from { opacity: .6; transform: scale(.45); } to { opacity: 0; transform: scale(1.5); } }
  @media(max-width:760px) { .landscape-wide { display: none; }.landscape-narrow { display: block; }.desert-sun { right: 7%; top: 15%; width: 75px; }.desert-cactus { stroke-width: 1.4; } }
  @media(prefers-reduced-motion:reduce) { .desert-sun { transition: none; }.sensor-packet,.sensor-ring { animation: none; }.sensor-packet { display: none; } }
</style>
