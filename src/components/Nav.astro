---
import { SITE_TITLE, SOCIALS } from '../consts';
const links = [
  { href: '/projects', label: 'Work' },
  { href: '/about', label: 'Experience' },
  { href: '/resume', label: 'Resume' },
  { href: '/studio', label: 'Studio ↗' },
  { href: '/life', label: 'Life' },
  { href: '/#contact', label: 'Contact' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => href !== '/#contact' && (current === href || current.startsWith(href + '/'));
---

<header class="site-navigation">
  <nav class="navigation-inner" aria-label="Main navigation">
    <a href="/" class="navigation-brand">{SITE_TITLE}<span>.</span></a>
    <div class="navigation-desktop">{links.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}</div>
    <details class="navigation-mobile" data-mobile-navigation>
      <summary aria-label="Navigation menu"><span>Menu</span><svg viewBox="0 0 20 20" width="19" height="19" aria-hidden="true"><path d="M3 6h14M3 14h14" fill="none" stroke="currentColor" stroke-width="1.4" /></svg></summary>
      <div class="navigation-panel">{links.map((link) => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}<div class="navigation-socials"><a href={SOCIALS.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={SOCIALS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></div></div>
    </details>
  </nav>
</header>
<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-mobile-navigation]').forEach((menu) => {
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  });
</script>
<style>
.site-navigation{position:sticky;top:0;z-index:50;background:#0a0b0de8;backdrop-filter:blur(14px);border-bottom:1px solid #23272e99}.navigation-inner{position:relative;display:flex;justify-content:space-between;align-items:center;gap:30px;max-width:1100px;margin:auto;padding:12px 32px;min-height:68px}.navigation-brand{font:600 .88rem var(--font-mono);letter-spacing:-.025em;white-space:nowrap}.navigation-brand span{color:var(--color-accent)}.navigation-desktop{display:flex;align-items:center;gap:29px}.navigation-desktop a{display:flex;align-items:center;min-height:44px;font:.65rem var(--font-mono);letter-spacing:.07em;text-transform:uppercase;color:var(--color-muted)}.navigation-desktop a:hover,.navigation-desktop a[aria-current],.navigation-panel a[aria-current]{color:var(--color-accent)}.navigation-mobile{display:none}.navigation-mobile summary{display:flex;align-items:center;justify-content:center;gap:15px;min-height:44px;min-width:75px;cursor:pointer;font:.7rem var(--font-mono);list-style:none}.navigation-mobile summary::-webkit-details-marker{display:none}.navigation-panel{position:absolute;top:100%;right:0;left:0;display:grid;padding:14px 24px 22px;background:#111317;border-bottom:1px solid var(--color-border-strong)}.navigation-panel>a{display:flex;align-items:center;min-height:48px;font:.8rem var(--font-mono);border-bottom:1px solid var(--color-border);color:var(--color-muted)}.navigation-socials{display:flex;gap:24px;margin-top:17px;font:.68rem var(--font-mono);color:var(--color-accent)}.navigation-socials a{display:flex;align-items:center;min-height:44px}a:focus-visible,summary:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px;border-radius:3px}@media(max-width:820px){.navigation-inner{padding-inline:24px;gap:15px}.navigation-desktop{display:none}.navigation-mobile{display:block}}
</style>
