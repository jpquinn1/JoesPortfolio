---
import TechStack from '../TechStack.astro';
import '../../styles/portfolio-work.css';
const areas = [
  { title: 'Embedded & device fleets', description: 'C++ controller firmware, watchdogs, provisioning, MQTT, signed over-the-air updates and fail-safe power control.' },
  { title: 'Cameras, AR & 3D', description: 'ARKit and Metal trace rendering, HEVC capture with per-frame camera data, and camera calibration.' },
  { title: 'Engineering applications', description: 'Desktop tools with geospatial and 3D views, simulation workflows, reports, and the tutorials that teach them.' },
  { title: 'Hardware & delivery', description: 'CAD for enclosures, circuit boards and mounts; CI, signed releases and operator runbooks.' },
];
---

<section id="focus" class="work-section scroll-mt-20" aria-labelledby="focus-title">
  <div class="work-section-heading"><div><p class="section-label">What I work on</p><h2 id="focus-title">Across the system.</h2></div></div>
  <div class="focus-list">{areas.map((area, index) => <div class="focus-item"><span class="focus-item-number">0{index + 1}</span><div><h3>{area.title}</h3><p>{area.description}</p></div></div>)}</div>
  <div class="focus-tools"><p class="work-fact-label">Core tools</p><TechStack tools={['cpp', 'python', 'swift', 'typescript', 'react', 'azure', 'aws']} /></div>
</section>
