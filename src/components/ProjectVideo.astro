---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  video: { src: string; poster: ImageMetadata; label: string };
}
const { title, video } = Astro.props;
const poster = await getImage({ src: video.poster, width: Math.min(1200, video.poster.width), format: 'webp' });
---

<div class="project-video" data-project-video data-portrait={video.poster.height > video.poster.width ? 'true' : undefined}>
  <video controls playsinline muted preload="none" poster={poster.src} aria-label={`${title} video demonstration`}>
    <source src={video.src} type="video/mp4" />
    <a href={video.src}>Watch the video demonstration</a>
  </video>
  <button class="project-video-play" type="button" aria-label={`Play ${title} demo`} hidden>
    <span class="project-video-play-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="27" height="27"><path d="m9 5 11 7-11 7Z" fill="currentColor" /></svg></span>
    <span class="project-video-label">{video.label}</span>
  </button>
  <span class="project-video-status" role="status"></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-project-video]').forEach(root => {
    const video = root.querySelector('video')!;
    const button = root.querySelector('button')!;
    const status = root.querySelector<HTMLElement>('[role="status"]')!;
    root.dataset.enhanced = 'true';
    video.controls = false;
    video.tabIndex = -1;
    button.hidden = false;
    button.addEventListener('click', async () => {
      button.hidden = true;
      status.textContent = '';
      root.dataset.started = 'true';
      video.controls = true;
      video.tabIndex = 0;
      try {
        await video.play();
        video.focus({ preventScroll: true });
      } catch {
        status.textContent = 'Use the video controls to start playback.';
      }
    });
    video.addEventListener('ended', () => {
      button.hidden = false;
      button.querySelector('.project-video-label')!.textContent = 'Watch again';
    });
  });
</script>

<style>
  .project-video{position:relative;z-index:2;width:100%;aspect-ratio:16/10;overflow:hidden;background:#090c10}
  .project-video video{display:block;width:100%;height:100%;object-fit:contain}
  .project-video[data-portrait][data-enhanced]:not([data-started]) video{object-fit:cover;object-position:center 42%}
  .project-video-play{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:17px;width:100%;border:0;background:linear-gradient(0deg,#05090d94,transparent 65%);color:#fff;cursor:pointer}
  .project-video-play[hidden]{display:none}
  .project-video-play-icon{display:grid;place-items:center;width:66px;height:66px;border:1px solid #ffffff80;border-radius:50%;background:#071318b8;box-shadow:0 8px 30px #0004;transition:background .2s,transform .2s}
  .project-video-play-icon svg{margin-left:2px}
  .project-video-play:hover .project-video-play-icon{background:#08776e;transform:scale(1.06)}
  .project-video-label{padding:9px 14px;border:1px solid #ffffff30;border-radius:30px;background:#071318cf;font:500 .75rem var(--font-mono,monospace);line-height:1.4}
  .project-video-play:focus-visible{outline:3px solid #5eead4;outline-offset:-5px}
  .project-video video:focus-visible{outline:2px solid #5eead4;outline-offset:-3px}
  .project-video-status{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}
  @media(prefers-reduced-motion:reduce){.project-video-play-icon{transition:none}}
</style>
